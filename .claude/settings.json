{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Development.json)",
      "Read(**/*.pfx)",
      "Read(**/*.snk)",
      "Read(**/credentials*)",
      "Read(**/*secret*.json)",
      "Read(~/.nuget/NuGet/NuGet.Config)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(./secrets/**)",
      "Read(**/prod.keys)",
      "Read(**/title.keys)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-cs.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dotnet build FitzLauncher.slnx -v q -nologo 1>&2 || exit 2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
