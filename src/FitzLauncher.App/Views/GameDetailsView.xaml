<UserControl x:Class="FitzLauncher.App.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Hero: the game's art, Console style -->
            <Grid Height="280" ClipToBounds="True">
                <Border Background="{StaticResource Surface2}" />
                <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Center" />
                <Border Background="{DynamicResource ArtScrim}" />
                <Border Background="{DynamicResource ArtFade}" />
                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,12">
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Secondary}" FontSize="13" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Display}" FontSize="38" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="24,8,24,32">
                <!-- Actions -->
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" ToolTip="Starts the game with Game Mode, FPS tracking and temperature alerts (Enter)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" /><TextBlock Text="Play" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding OpenModsCommand}" ToolTip="Find, install and troubleshoot mods for this game"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74C;" FontSize="14" /><TextBlock Text="Mods" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditCommand}" />
                        <Button Content="Folder" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" />
                        <Button Content="Remove" Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                </DockPanel>

                <!-- Status / busy -->
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Secondary}" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Visibility="{Binding Status, Converter={StaticResource HasValue}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                </Border>

                <!-- FPS targets -->
                <TextBlock Text="FPS target" Style="{StaticResource H2}" />
                <TextBlock Text="One click sets the cap and applies every change that doesn't affect image quality" Style="{StaticResource Wrap}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Targets}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <RadioButton Style="{StaticResource TargetToggle}" GroupName="target"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding Command}" CommandParameter="{Binding Value}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Figure}" FontSize="14" />
                                </RadioButton>
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,16,0"
                                         Visibility="{Binding IsSuggested, Converter={StaticResource Vis}}" ToolTip="Suggested for your PC" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SuggestedTargetText}" Style="{StaticResource Wrap}" Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OptimiseCommand}" Padding="24,8"
                            ToolTip="Scans every game file and applies all tweaks that don't reduce image quality, plus the frame cap for your target." ><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" /><TextBlock Text="Optimise" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Content="Rescan" Margin="8,0,0,0" Command="{Binding RescanCommand}" />
                    <Button Content="Revert all" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding RevertAllCommand}"
                            Visibility="{Binding HasChanges, Converter={StaticResource Vis}}" ToolTip="Restore every setting the launcher changed for this game" />
                </StackPanel>
                <TextBlock Text="{Binding AppliedSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                <!-- Scan facts -->
                <ItemsControl ItemsSource="{Binding ScanFacts}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Muted}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notes -->
                <ItemsControl ItemsSource="{Binding Notes}" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Warn}" Margin="0,8,12,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- One-click list -->
                <TextBlock Text="Included in Optimise (no visual change)" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding OneClick}" ItemTemplate="{StaticResource OneClickRow}" />

                <!-- Suggestions -->
                <DockPanel Margin="0,16,0,8" Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}">
                    <Button DockPanel.Dock="Right" Content="Apply recommended" Command="{Binding ApplyRecommendedCommand}" />
                    <TextBlock Text="Graphics suggestions" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="These trade a little image quality for FPS. They're marked Recommended when your last session missed the target. Each one can be reverted."
                           Style="{StaticResource Wrap}" Margin="0,0,0,8" Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource TweakRow}" />

                <!-- Library / progress -->
                <TextBlock Text="Progress" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding StatusOptions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipToggle}" GroupName="playstatus" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,8,0,4" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshAchievementsCommand}" ToolTip="Read achievements again">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                    </Button>
                    <TextBlock Text="{Binding AchievementsText}" Style="{StaticResource Wrap}" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tags (comma separated)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Main story (h)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding MainStoryHoursText, UpdateSourceTrigger=LostFocus}" ToolTip="Roughly how long the main story is. The progress bar compares this with your playtime." />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Done %" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CompletionText, UpdateSourceTrigger=LostFocus}" ToolTip="Optional: type the completion % from the game's menu. It overrides the hours estimate." />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox Content="Favourite" IsChecked="{Binding Favourite}" Margin="0,0,20,0" />
                    <CheckBox Content="Hide from library" IsChecked="{Binding Hidden}" />
                </StackPanel>

                <!-- Auto-tune -->
                <DockPanel Margin="0,16,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="On" IsChecked="{Binding AutoTuneOn}" />
                    <TextBlock Text="Auto-tune" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding AutoTuneStatus}" Style="{StaticResource Wrap}" />
                <ItemsControl ItemsSource="{Binding AutoTuneSteps}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13" />
                                    <TextBlock Text="{Binding Result}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Outcome}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Reset auto-tune history" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding ResetAutoTuneCommand}"
                        Visibility="{Binding HasAutoTuneSteps, Converter={StaticResource Vis}}" ToolTip="Forget what was tried (applied changes stay; use Revert to undo them)" />

                <!-- Display -->
                <DockPanel Margin="0,16,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="Auto" IsChecked="{Binding AutoDisplayOn}" ToolTip="Pick resolution and render scale for the screen that's active when you press Play" />
                    <TextBlock Text="Display" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource Wrap}" />
                <ItemsControl ItemsSource="{Binding DisplayProfiles}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource GhostButton}" ToolTip="Forget what was learned for this screen"
                                        Command="{Binding DataContext.ResetDisplayProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource Muted}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CPU & thermals -->
                <TextBlock Text="CPU cores &amp; thermals" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding PinningOptions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipToggle}" GroupName="pinning" Content="{Binding Label}" ToolTip="{Binding Hint}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SetPinningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding PinningText}" Style="{StaticResource MutedText}" />
                <CheckBox Content="Thermal guard: lower the RTSS cap a step if the CPU/GPU runs hot, restore it when cool" IsChecked="{Binding ThermalGuardOn}" Margin="0,8,0,0" />
                <CheckBox Content="Pause this game while the device sleeps (turn off for online games)" IsChecked="{Binding PauseOnSleepOn}" Margin="0,8,0,0" />

                <TextBlock Text="{Binding LimiterText}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding LimiterText, Converter={StaticResource HasValue}}" />

                <!-- Power (APUs) -->
                <StackPanel Visibility="{Binding ShowPower, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,24,0,8">
                        <CheckBox DockPanel.Dock="Right" Content="Manage" IsChecked="{Binding PowerOn}" ToolTip="Set and learn this game's power limit (RyzenAdj)" />
                        <TextBlock Text="Power limit" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource Wrap}" />
                    <Button Content="Reset learned power" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding ResetPowerCommand}" />
                </StackPanel>

                <!-- ReShade / ENB -->
                <StackPanel Visibility="{Binding HasMods, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,24,0,8">
                        <CheckBox DockPanel.Dock="Right" Content="On" IsChecked="{Binding ModsOn}" ToolTip="Off renames the mod's DLL so the game starts without it; on puts it back" />
                        <TextBlock Text="Visual mods" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ModsText}" Style="{StaticResource Wrap}" />
                </StackPanel>

                <!-- Benchmarks -->
                <TextBlock Text="Benchmarks" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding BenchmarkHint}" Style="{StaticResource Wrap}" />
                <ItemsControl ItemsSource="{Binding Benchmarks}" Margin="0,8,0,0" Visibility="{Binding HasBenchmarks, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" ToolTip="{Binding Label}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="1" FontSize="12">
                                    <Run Text="{Binding Avg, Mode=OneWay}" FontWeight="Medium" /><Run Text=" avg · " Foreground="{StaticResource Muted}" />
                                    <Run Text="{Binding Low, Mode=OneWay}" /><Run Text=" 1% · " Foreground="{StaticResource Muted}" />
                                    <Run Text="{Binding PointLow, Mode=OneWay}" /><Run Text=" 0.1% · " Foreground="{StaticResource Muted}" />
                                    <Run Text="{Binding AtTarget, Mode=OneWay}" /><Run Text=" on target" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Delta}" FontSize="12" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Save backups -->
                <DockPanel Margin="0,16,0,8">
                    <CheckBox DockPanel.Dock="Right" Content="Auto backup" IsChecked="{Binding BackupSavesOn}" ToolTip="Back up before and after every session (only when saves changed)" />
                    <TextBlock Text="Save backups" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding SaveDirs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButton}" ToolTip="Remove this folder"
                                        Command="{Binding DataContext.RemoveSaveDirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource ChipButton}" Content="Find saves" Command="{Binding FindSavesCommand}" ToolTip="Checks Goldberg/CODEX/RUNE/EMPRESS/OnlineFix emulator folders, Unreal/Unity locations and folders named after the game" />
                    <Button Style="{StaticResource ChipButton}" Content="Add folder…" Command="{Binding AddSaveDirCommand}" />
                    <Button Style="{StaticResource ChipButton}" Content="Back up now" Command="{Binding BackupNowCommand}" />
                    <Button Style="{StaticResource ChipButton}" Content="Open backups" Command="{Binding OpenBackupFolderCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Wrap}" Visibility="{Binding SaveStatus, Converter={StaticResource HasValue}}" />
                <ItemsControl ItemsSource="{Binding Backups}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Restore" Style="{StaticResource ChipButton}" Margin="0"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource Muted}" /><Run Text="{Binding Size, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Runtimes -->
                <TextBlock Text="Runtimes (won't start? check here)" Style="{StaticResource H2}" />
                <WrapPanel>
                    <Button Style="{StaticResource ChipButton}" Content="Check bundled runtimes" Command="{Binding CheckRuntimesCommand}" />
                    <Button Style="{StaticResource ChipButton}" Content="Install missing" Command="{Binding InstallMissingRuntimesCommand}"
                            Visibility="{Binding HasMissingRuntimes, Converter={StaticResource Vis}}" />
                </WrapPanel>
                <TextBlock Text="{Binding RuntimeStatus}" Style="{StaticResource Wrap}" Visibility="{Binding RuntimeStatus, Converter={StaticResource HasValue}}" />
                <ItemsControl ItemsSource="{Binding Runtimes}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Mods & trainer -->
                <TextBlock Text="Mods" Style="{StaticResource H2}" />
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Manage" Style="{StaticResource PrimaryButton}" Command="{Binding OpenModsCommand}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ModsSummary}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <DockPanel Margin="0,24,0,8">
                    <Button DockPanel.Dock="Right" Content="Open page" Style="{StaticResource GhostButton}" Command="{Binding OpenTrainerPageCommand}" />
                    <TextBlock Text="Trainer" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <!-- No trainer yet / finding one -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasTrainer, Converter={StaticResource NotVis}}">
                    <StackPanel>
                        <TextBlock Text="Free FLiNG trainers: the launcher finds the one for this game, checks it matches your version, and opens it with the game." Style="{StaticResource Wrap}" />
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Find FLiNG trainer" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding FindTrainerCommand}" />
                            <TextBox Text="{Binding TrainerQuery, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Button Content="Use a downloaded trainer…" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding UseTrainerFileCommand}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding IsFindingTrainer, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TrainerResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding PickCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TrainerPageTitle}" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,8,0,4" Visibility="{Binding TrainerPageTitle, Converter={StaticResource HasValue}}" />
                        <ItemsControl ItemsSource="{Binding TrainerDownloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Download" Command="{Binding DownloadCommand}" VerticalAlignment="Top" />
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Match}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Windows Security often flags trainers because they edit game memory. The launcher never changes your antivirus; if it blocks the file, you decide in Protection history." Style="{StaticResource Wrap}" FontSize="12" Margin="0,8,0,0" />
                        <Button Content="Close" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding CancelFindTrainerCommand}" />
                    </StackPanel>
                </Border>
                <!-- Trainer set up -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasTrainer, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Update" Style="{StaticResource GhostButton}" Command="{Binding FindTrainerCommand}" />
                                <Button Content="Remove" Style="{StaticResource GhostButton}" Command="{Binding RemoveTrainerCommand}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding TrainerName}" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TrainerMatchText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Content="Open it with the game" IsChecked="{Binding TrainerLaunchWithGame}" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0" IsEnabled="{Binding TrainerLaunchWithGame}">
                            <TextBlock Text="after" VerticalAlignment="Center" />
                            <TextBox Text="{Binding TrainerDelay}" Width="48" Margin="8,0" />
                            <TextBlock Text="seconds (once the game has loaded)" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Content="Close it when the game closes" IsChecked="{Binding TrainerCloseWithGame}" Margin="0,8,0,0" />
                        <TextBlock Text="Your usual cheats (shown in the overlay when the trainer opens)" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding Cheats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Favourite}" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Keycap}"><TextBlock Text="{Binding Hotkey}" Style="{StaticResource Figure}" FontSize="12" /></Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Report card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding HasCrash, Converter={StaticResource Vis}}" BorderBrush="{StaticResource Bad}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Roll back" VerticalAlignment="Top" Margin="12,0,0,0" Command="{Binding RollBackCommand}"
                                Visibility="{Binding CanRollBack, Converter={StaticResource Vis}}" ToolTip="Undo every change made since the last session that ended normally" />
                        <StackPanel>
                            <TextBlock Text="Last session crashed" Foreground="{StaticResource Bad}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CrashText}" Style="{StaticResource Wrap}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <StackPanel Visibility="{Binding HasReport, Converter={StaticResource Vis}}" Margin="0,0,0,24">
                    <TextBlock Text="Report card" Style="{StaticResource H2}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="72" VerticalAlignment="Top">
                                <TextBlock Text="{Binding ReportGrade}" Style="{StaticResource Figure}" FontSize="40" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="{Binding ReportScore}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding ReportSmoothness}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding ReportTemps}" Style="{StaticResource Wrap}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ReportStability}" Style="{StaticResource Wrap}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ReportNext}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Margin="0,8,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- History -->
                <TextBlock Text="Performance" Style="{StaticResource H2}" />
                <TextBlock Text="Play a session and the launcher will record your average FPS, 1% lows and temperatures here." Style="{StaticResource Wrap}"
                           Visibility="{Binding HasHistory, Converter={StaticResource NotVis}}" />
                <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding LastSessionText}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Figure}" FontSize="12" Foreground="{DynamicResource Accent}" Text="{Binding TargetLabel}" />
                                <TextBlock Text="Last session, FPS over time" Style="{StaticResource MutedText}" />
                            </DockPanel>
                            <!-- The one detailed graphic: FPS trace against the cap line -->
                            <Canvas Width="400" Height="96" HorizontalAlignment="Left" ClipToBounds="True">
                                <Line X1="0" X2="400" Y1="{Binding TargetY}" Y2="{Binding TargetY}" Stroke="{DynamicResource Accent}" StrokeThickness="1" StrokeDashArray="4 3"
                                      Visibility="{Binding HasTargetLine, Converter={StaticResource Vis}}" />
                                <Polyline Points="{Binding LastTimeline}" Stroke="{StaticResource Text}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </Canvas>
                            <TextBlock Text="Average FPS per session" Style="{StaticResource MutedText}" Margin="0,16,0,8" />
                            <Canvas Width="400" Height="40" HorizontalAlignment="Left">
                                <Polyline Points="{Binding HistoryLine}" Stroke="{StaticResource Secondary}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </Canvas>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" FontSize="12">
                                        <Run Text="{Binding Avg, Mode=OneWay}" FontWeight="Medium" /><Run Text=" avg · " Foreground="{StaticResource Muted}" />
                                        <Run Text="{Binding Low, Mode=OneWay}" /><Run Text=" 1% low · " Foreground="{StaticResource Muted}" />
                                        <Run Text="{Binding Temps, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
