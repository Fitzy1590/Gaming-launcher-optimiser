<UserControl x:Class="FitzLauncher.App.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Hero -->
            <Grid Height="190">
                <Border Background="{StaticResource Surface2}" />
                <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Center" />
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00161A20" Offset="0.2" />
                            <GradientStop Color="#FF161A20" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,10">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="22,8,22,28">
                <!-- Actions -->
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="▶  Play" Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" ToolTip="Starts the game with Game Mode, FPS tracking and temperature alerts (Enter)" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditCommand}" />
                        <Button Content="Folder" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" />
                        <Button Content="Remove" Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" Foreground="{StaticResource Bad}" />
                    </StackPanel>
                </DockPanel>

                <!-- Status / busy -->
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Accent}" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                <Border Background="#1434D399" CornerRadius="8" Padding="10,8" Margin="0,12,0,0" Visibility="{Binding Status, Converter={StaticResource HasValue}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                </Border>

                <!-- FPS targets -->
                <TextBlock Text="FPS target: one click to optimise" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Targets}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <RadioButton Style="{StaticResource TargetToggle}" GroupName="target"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding Command}" CommandParameter="{Binding Value}">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                                </RadioButton>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,11,0"
                                         Visibility="{Binding IsSuggested, Converter={StaticResource Vis}}" ToolTip="Suggested for your PC" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SuggestedTargetText}" Style="{StaticResource Wrap}" Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="⚡ Optimise" Style="{StaticResource PrimaryButton}" Command="{Binding OptimiseCommand}" Padding="22,9"
                            ToolTip="Scans every game file and applies all tweaks that don't reduce image quality, plus the frame cap for your target." />
                    <Button Content="Rescan" Margin="8,0,0,0" Command="{Binding RescanCommand}" />
                    <Button Content="Revert all" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding RevertAllCommand}"
                            Visibility="{Binding HasChanges, Converter={StaticResource Vis}}" ToolTip="Restore every setting the launcher changed for this game" />
                </StackPanel>
                <TextBlock Text="{Binding AppliedSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                <!-- Scan facts -->
                <ItemsControl ItemsSource="{Binding ScanFacts}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notes -->
                <ItemsControl ItemsSource="{Binding Notes}" Visibility="{Binding HasNotes, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#14FBBF24" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding}" Style="{StaticResource Wrap}" Foreground="{StaticResource Warn}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- One-click list -->
                <TextBlock Text="Included in Optimise (no visual change)" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding OneClick}" ItemTemplate="{StaticResource OneClickRow}" />

                <!-- Suggestions -->
                <DockPanel Margin="0,18,0,8" Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}">
                    <Button DockPanel.Dock="Right" Content="Apply recommended" Command="{Binding ApplyRecommendedCommand}" />
                    <TextBlock Text="Graphics suggestions" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="These trade a little image quality for FPS. They're marked Recommended when your last session missed the target. Each one can be reverted."
                           Style="{StaticResource Wrap}" Margin="0,0,0,10" Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}" />
                <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource TweakRow}" />

                <!-- History -->
                <TextBlock Text="Performance" Style="{StaticResource H2}" />
                <TextBlock Text="Play a session and the launcher will record your average FPS, 1% lows and temperatures here." Style="{StaticResource Wrap}"
                           Visibility="{Binding HasHistory, Converter={StaticResource NotVis}}" />
                <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding LastSessionText}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Last session: FPS over time" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <Canvas Width="360" Height="60" HorizontalAlignment="Left">
                                <Polyline Points="{Binding LastTimeline}" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round" />
                            </Canvas>
                            <TextBlock Text="Average FPS per session" Style="{StaticResource MutedText}" Margin="0,12,0,6" />
                            <Canvas Width="360" Height="60" HorizontalAlignment="Left">
                                <Polyline Points="{Binding HistoryLine}" Stroke="{StaticResource Good}" StrokeThickness="2" StrokeLineJoin="Round" />
                            </Canvas>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" FontSize="12">
                                        <Run Text="{Binding Avg, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" avg · " Foreground="{StaticResource Muted}" />
                                        <Run Text="{Binding Low, Mode=OneWay}" /><Run Text=" 1% low · " Foreground="{StaticResource Muted}" />
                                        <Run Text="{Binding Temps, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
