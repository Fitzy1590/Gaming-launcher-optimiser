<Window x:Class="FitzLauncher.App.Views.DeviceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fitz Launcher · device check" Width="760" Height="720" MinHeight="420"
        Background="{DynamicResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/Assets/fitz.ico">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Device check" Style="{StaticResource H1}" />
            <TextBlock Text="What this PC has for the launcher and your games. Runs on first start and after each update." Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,16">
                <ProgressBar IsIndeterminate="True" Width="48" Height="3" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" FontSize="15" />
            </StackPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource PlayButton}" Padding="28,8" FontSize="14" Click="Close_Click" IsDefault="True" />
            <Button Content="Check again" HorizontalAlignment="Left" Command="{Binding RunCommand}" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Install" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding InstallCommand}" Visibility="{Binding CanInstall, Converter={StaticResource Vis}}" />
                                    <Button Content="{Binding FixLabel}" Margin="8,0,0,0" Command="{Binding OpenFixCommand}" Visibility="{Binding HasFix, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <Ellipse x:Name="dot" DockPanel.Dock="Left" Width="10" Height="10" Fill="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,12,0" />
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Wrap}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Ok"><Setter TargetName="dot" Property="Fill" Value="{StaticResource Good}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Recommended"><Setter TargetName="dot" Property="Fill" Value="{StaticResource Warn}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Required"><Setter TargetName="dot" Property="Fill" Value="{StaticResource Bad}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
