<UserControl x:Class="FitzLauncher.App.Views.ControllerProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibleChanged">
    <!-- Edits a ControllerProfileViewModel: sticks, triggers, rumble, layout -->
    <StackPanel>
        <TextBlock Text="{Binding PreviewText}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
        <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="Left stick" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                    <!-- Live preview: dot = physical stick, ring = what the game gets -->
                    <Canvas Width="120" Height="120" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Ellipse Width="120" Height="120" Stroke="{StaticResource StrongBorder}" StrokeThickness="1" />
                        <Ellipse Width="16" Height="16" Stroke="{DynamicResource Accent}" StrokeThickness="2" Canvas.Left="{Binding LeftOutX}" Canvas.Top="{Binding LeftOutY}" />
                        <Ellipse Width="12" Height="12" Fill="{StaticResource Text}" Canvas.Left="{Binding LeftRawX}" Canvas.Top="{Binding LeftRawY}" />
                    </Canvas>
                <StackPanel Margin="0,0,0,10" ToolTip="Stops drift: movement inside this is ignored">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding LeftInner, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-90)" AutomationProperties.Name="Deadzone percent" />
                        <TextBlock Text="Deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="90" Value="{Binding LeftInner}" AutomationProperties.Name="Deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" ToolTip="Full output before the edge of the stick">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding LeftOuter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-50)" AutomationProperties.Name="Outer deadzone percent" />
                        <TextBlock Text="Outer deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding LeftOuter}" AutomationProperties.Name="Outer deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" ToolTip="Counter the game's own deadzone so small movements register">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding LeftAnti, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-50)" AutomationProperties.Name="Anti-deadzone percent" />
                        <TextBlock Text="Anti-deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding LeftAnti}" AutomationProperties.Name="Anti-deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding LeftSensitivity, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (50-150)" AutomationProperties.Name="Sensitivity percent" />
                        <TextBlock Text="Sensitivity" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="50" Maximum="150" Value="{Binding LeftSensitivity}" AutomationProperties.Name="Sensitivity" />
                </StackPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Leftcurve" Content="Linear" IsChecked="{Binding LeftCurve, Converter={StaticResource Eq}, ConverterParameter=Linear}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Leftcurve" Content="Smooth" IsChecked="{Binding LeftCurve, Converter={StaticResource Eq}, ConverterParameter=Smooth}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Leftcurve" Content="Precise" IsChecked="{Binding LeftCurve, Converter={StaticResource Eq}, ConverterParameter=Precise}" ToolTip="Finer control near the centre (aiming)" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Leftcurve" Content="Aggressive" IsChecked="{Binding LeftCurve, Converter={StaticResource Eq}, ConverterParameter=Aggressive}" ToolTip="Faster response from small movements" />
                    </WrapPanel>
                    <CheckBox Content="Invert up/down" IsChecked="{Binding LeftInvert}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="Right stick" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                    <!-- Live preview: dot = physical stick, ring = what the game gets -->
                    <Canvas Width="120" Height="120" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Ellipse Width="120" Height="120" Stroke="{StaticResource StrongBorder}" StrokeThickness="1" />
                        <Ellipse Width="16" Height="16" Stroke="{DynamicResource Accent}" StrokeThickness="2" Canvas.Left="{Binding RightOutX}" Canvas.Top="{Binding RightOutY}" />
                        <Ellipse Width="12" Height="12" Fill="{StaticResource Text}" Canvas.Left="{Binding RightRawX}" Canvas.Top="{Binding RightRawY}" />
                    </Canvas>
                <StackPanel Margin="0,0,0,10" ToolTip="Stops drift: movement inside this is ignored">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding RightInner, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-90)" AutomationProperties.Name="Deadzone percent" />
                        <TextBlock Text="Deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="90" Value="{Binding RightInner}" AutomationProperties.Name="Deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" ToolTip="Full output before the edge of the stick">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding RightOuter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-50)" AutomationProperties.Name="Outer deadzone percent" />
                        <TextBlock Text="Outer deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding RightOuter}" AutomationProperties.Name="Outer deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" ToolTip="Counter the game's own deadzone so small movements register">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding RightAnti, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-50)" AutomationProperties.Name="Anti-deadzone percent" />
                        <TextBlock Text="Anti-deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="50" Value="{Binding RightAnti}" AutomationProperties.Name="Anti-deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding RightSensitivity, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (50-150)" AutomationProperties.Name="Sensitivity percent" />
                        <TextBlock Text="Sensitivity" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="50" Maximum="150" Value="{Binding RightSensitivity}" AutomationProperties.Name="Sensitivity" />
                </StackPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Rightcurve" Content="Linear" IsChecked="{Binding RightCurve, Converter={StaticResource Eq}, ConverterParameter=Linear}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Rightcurve" Content="Smooth" IsChecked="{Binding RightCurve, Converter={StaticResource Eq}, ConverterParameter=Smooth}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Rightcurve" Content="Precise" IsChecked="{Binding RightCurve, Converter={StaticResource Eq}, ConverterParameter=Precise}" ToolTip="Finer control near the centre (aiming)" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="Rightcurve" Content="Aggressive" IsChecked="{Binding RightCurve, Converter={StaticResource Eq}, ConverterParameter=Aggressive}" ToolTip="Faster response from small movements" />
                    </WrapPanel>
                    <CheckBox Content="Invert up/down" IsChecked="{Binding RightInvert}" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Triggers" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                <StackPanel Margin="0,0,0,10" ToolTip="Light presses below this are ignored">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding TriggerDeadzone, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (0-90)" AutomationProperties.Name="Deadzone percent" />
                        <TextBlock Text="Deadzone" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="90" Value="{Binding TriggerDeadzone}" AutomationProperties.Name="Deadzone" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" ToolTip="Lower = hair trigger: full output from a partial press">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBox DockPanel.Dock="Right" Width="56" TextAlignment="Right" Text="{Binding TriggerMax, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type an exact value (10-100)" AutomationProperties.Name="Full press at percent" />
                        <TextBlock Text="Full press at" VerticalAlignment="Center" />
                    </DockPanel>
                    <Slider Minimum="10" Maximum="100" Value="{Binding TriggerMax}" AutomationProperties.Name="Full press at" />
                </StackPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Live" Width="120" Style="{StaticResource MutedText}" />
                    <ProgressBar Value="{Binding LeftTriggerOut, Mode=OneWay}" Maximum="100" Height="4" Width="120" Margin="0,0,12,0" />
                    <ProgressBar Value="{Binding RightTriggerOut, Mode=OneWay}" Maximum="100" Height="4" Width="120" HorizontalAlignment="Left" />
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Vibration and buttons" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Test" Margin="8,0,0,0" Command="{Binding TestRumbleCommand}" />
                    <TextBlock DockPanel.Dock="Left" Text="Rumble strength" Width="120" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Vibration, StringFormat={}{0}%}" Width="48" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Figure}" FontSize="12" />
                    <Slider Minimum="0" Maximum="200" Value="{Binding Vibration}" TickFrequency="5" LargeChange="10" ToolTip="0 = off. Above 100% boosts weak rumble." />
                </DockPanel>
                <CheckBox Content="Swap A/B and X/Y (Nintendo layout)" IsChecked="{Binding SwapFace}" Margin="0,4,0,0" />
                <Button Content="Reset to defaults" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ResetCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
