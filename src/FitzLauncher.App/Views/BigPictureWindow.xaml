<Window x:Class="FitzLauncher.App.Views.BigPictureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitzLauncher.App.ViewModels"
        Title="Fitz Launcher: Big Picture" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Grid>
        <!-- Backdrop: selected game's hero art, darkened -->
        <Image Source="{Binding Details.Hero}" Stretch="UniformToFill" Opacity="0.35" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990E1014" Offset="0" />
                    <GradientStop Color="#FF0E1014" Offset="0.75" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="70,50,70,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="Clock" FontSize="22" Foreground="{StaticResource Muted}" />
                <TextBlock Text="Fitz Launcher" FontSize="30" FontWeight="SemiBold" />
            </DockPanel>

            <!-- Cover carousel -->
            <ListBox Grid.Row="1" x:Name="Carousel" ItemsSource="{Binding GamesView}" SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False"
                     Focusable="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Margin" Value="14" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ring" CornerRadius="16" BorderThickness="4" BorderBrush="Transparent" Padding="3">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Setter.Value></Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <Grid Width="250" Height="375">
                            <Border CornerRadius="12" Background="{StaticResource Surface2}">
                                <TextBlock Text="{Binding Initials}" FontSize="64" FontWeight="Bold" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="12" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected game -->
            <StackPanel Grid.Row="2" DataContext="{Binding Details}" Margin="0,10,0,20">
                <TextBlock Text="{Binding Name}" FontSize="40" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Width="420" HorizontalAlignment="Left" Margin="0,12,0,0"
                             Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding LastSessionText}" FontSize="16" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="FPS target" FontSize="16" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ItemsControl ItemsSource="{Binding Targets}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="b" CornerRadius="10" Padding="18,8" Margin="0,0,8,0" Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2">
                                    <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BusyText}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="15" Foreground="{StaticResource Good}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None" MaxWidth="1100" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Button hints -->
            <TextBlock Grid.Row="3" FontSize="17" Foreground="{StaticResource Muted}"
                       Text="Ⓐ Play    Ⓧ Optimise    LB / RB  FPS target (1-click optimise)    Ⓨ Favourite    Ⓑ Exit     ·     Keyboard: ← → Enter  X  Q/E  F  Esc" />
        </Grid>
    </Grid>
</Window>
