<UserControl x:Class="FitzLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Settings are plain objects; every toggle/edit saves via the Save command or when you leave the page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />

            <TextBlock Text="Default FPS target for new games" Style="{StaticResource H2}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="90"  IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=90}" />
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="100" IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=100}" />
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="110" IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=110}" />
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="117" IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=117}" />
            </StackPanel>

            <TextBlock Text="Game Mode (turns on automatically when you press Play)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Enable Game Mode" IsChecked="{Binding G.Enabled}" FontWeight="Medium" />
                    <StackPanel Margin="0,8,0,0" IsEnabled="{Binding G.Enabled}">
                        <CheckBox Content="Switch to the High performance power plan (skipped automatically on AMD X3D CPUs and on battery)" IsChecked="{Binding G.SwitchPowerPlan}" />
                        <CheckBox Content="Clear RAM before launch (standby list purge)" IsChecked="{Binding G.ClearRam}" />
                        <CheckBox Content="Memory guard: purge standby memory during play when free RAM runs low" IsChecked="{Binding G.StandbyListGuard}" />
                        <CheckBox Content="Pause Windows Update, background downloads, indexing and telemetry services" IsChecked="{Binding G.StopServices}" />
                        <CheckBox Content="Close updaters and pause sync apps (OneDrive) during play" IsChecked="{Binding G.CloseBackgroundApps}" />
                        <CheckBox Content="Run the game at High priority" IsChecked="{Binding G.RaiseGamePriority}" />
                        <CheckBox Content="Lower the priority of browsers and other background apps" IsChecked="{Binding G.LowerBackgroundPriority}" />
                        <CheckBox Content="Background CPU limiter: throttle any app that grabs a lot of CPU while you play, until it calms down" IsChecked="{Binding S.BackgroundLimiter}" />
                        <CheckBox Content="Keep all CPU cores awake while playing (core parking off; skipped on X3D CPUs, which rely on it)" IsChecked="{Binding S.CoreParkingOff}" />
                        <CheckBox Content="0.5 ms timer resolution (Windows 10 only; Windows 11 handles this per game)" IsChecked="{Binding G.HighResolutionTimer}" />
                    </StackPanel>
                    <TextBlock Text="Everything is restored when the game closes, and also on the next start if the PC crashes mid-game." Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Game Mode lists (one per line)" Style="{StaticResource H2}" />
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="Services paused while playing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ServicesText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Apps closed while playing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CloseText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Apps paused (suspended) while playing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SuspendText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Apps lowered to below-normal priority" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding LowPriorityText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </UniformGrid>
            <Button Content="Reset lists to defaults" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ResetGameModeListsCommand}" />

            <TextBlock Text="Temperature alerts" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="CPU alert at" VerticalAlignment="Center" Width="110" />
                        <TextBox Text="{Binding S.CpuTempAlertC}" Width="70" />
                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="8,0,32,0" />
                        <TextBlock Text="GPU alert at" VerticalAlignment="Center" Width="100" />
                        <TextBox Text="{Binding S.GpuTempAlertC}" Width="70" />
                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Only alert after" VerticalAlignment="Center" Width="110" />
                        <TextBox Text="{Binding S.TempAlertSustainSeconds}" Width="70" />
                        <TextBlock Text="seconds above the limit" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <CheckBox Content="Show an on-screen alert over the game (borderless / windowed games)" IsChecked="{Binding S.TempAlertOverlay}" />
                    <CheckBox Content="Play a warning sound (works in exclusive fullscreen too)" IsChecked="{Binding S.TempAlertSound}" />
                    <TextBlock Text="Typical safe limits: CPU 90-95 °C (many laptops and Ryzen 7000 run at 95 °C by design); GPU core 83-87 °C." Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Display" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="At launch, set each game's resolution for the active screen (handheld or monitor) and learn the render scale that holds the FPS target there" IsChecked="{Binding S.AutoDisplay}" />
                    <CheckBox Content="Allow a lower output resolution for engines without a render-scale setting (Unity/Source) when the target isn't reachable" IsChecked="{Binding S.AllowLowerOutputResolution}" />
                    <TextBlock Text="Unreal games keep your screen's native resolution and render internally at a lower scale (upscaled by the engine), which keeps the image sharp. Other engines use native resolution unless you allow the option above."
                               Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Power limit (Ryzen APUs)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Set a power limit per game and learn the lowest one that still holds the FPS target" IsChecked="{Binding S.PowerControl}" />
                    <TextBlock Text="Uses RyzenAdj, the free tool handheld utilities use. Download it once from github.com/FlyGoat/RyzenAdj. If your device's own app (OneXConsole) also sets the power limit, turn that off while the launcher manages it, or the two will fight."
                               Style="{StaticResource Wrap}" Margin="0,8,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Browse…" Command="{Binding PickRyzenAdjCommand}" Margin="8,0,0,0" />
                            <Button Content="Test" Command="{Binding TestPowerCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding RyzenAdjText}" Style="{StaticResource Figure}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding S.PowerControl}">
                        <TextBlock Text="Start at" VerticalAlignment="Center" Width="64" />
                        <TextBox Text="{Binding S.PowerDefaultWatts}" Width="56" />
                        <TextBlock Text="W, between" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox Text="{Binding S.PowerMinWatts}" Width="56" />
                        <TextBlock Text="and" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox Text="{Binding S.PowerMaxWatts}" Width="56" />
                        <TextBlock Text="W" VerticalAlignment="Center" Margin="8,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding PowerStatus}" Style="{StaticResource Wrap}" Margin="0,8,0,0" Visibility="{Binding PowerStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Look" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Match colours to the selected game (accent and background come from its cover art)" IsChecked="{Binding MatchGameColours}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Mods" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Nexus Mods needs your free account's personal API key (Nexus → Site preferences → API keys). It's stored encrypted for your Windows user only. Free accounts install through the site's Mod Manager Download button; Premium accounts can install straight from the launcher. Thunderstore needs nothing."
                               Style="{StaticResource Wrap}" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Save" Margin="8,0,0,0" Command="{Binding SaveNexusKeyCommand}" />
                            <Button Content="Get key" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenNexusKeyPageCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Nexus API key" Width="110" VerticalAlignment="Center" />
                        <TextBox Text="{Binding NexusKeyInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Paste the key and Save. Save with the box empty to remove it." />
                    </DockPanel>
                    <TextBlock Text="A Nexus key is saved." Style="{StaticResource MutedText}" Margin="110,0,0,8" Visibility="{Binding HasNexusKey, Converter={StaticResource Vis}}" />
                    <CheckBox Content="Open Nexus &quot;Mod Manager Download&quot; links in Fitz Launcher (your previous mod manager gets them back if you turn this off)" IsChecked="{Binding NxmHandler}" Margin="0,0,0,12" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Save" Margin="8,0,0,0" Command="{Binding SaveModIoKeyCommand}" />
                            <Button Content="Get key" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenModIoKeyPageCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="mod.io API key" Width="110" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ModIoKeyInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="A mod.io key is saved." Style="{StaticResource MutedText}" Margin="110,0,0,8" Visibility="{Binding HasModIoKey, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding ModsStatus}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Visibility="{Binding ModsStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Sleep and resume" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Pause the game when the screen turns off or the device sleeps, and carry on where you left off when it wakes" IsChecked="{Binding S.PauseOnSleep}" />
                    <CheckBox Content="Let the device sleep when idle during a game (controller input counts as activity)" IsChecked="{Binding S.IdleSleepInGame}" />
                    <TextBlock Text="Press the power button (or leave it idle) and the game is frozen: no CPU, no sound, no heat in your bag. Wake it, sign in, and the game unfreezes after a second with your FPS cap, power limit and undervolt put back. Sleep time isn't counted as play time. Turn pausing off per game on the game page for online games that drop the connection anyway."
                               Style="{StaticResource Wrap}" Margin="0,8,0,8" />
                    <TextBlock Text="{Binding IdleTimeoutsText}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="To skip the PIN on wake: Sign-in options → 'If you've been away, when should Windows require you to sign in again?' → Never. For long breaks, Windows can hibernate after a while asleep; the game survives that too."
                               Style="{StaticResource Wrap}" Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Windows sleep timers" Command="{Binding OpenSleepSettingsCommand}" />
                        <Button Content="Sign-in options" Command="{Binding OpenSignInSettingsCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Undervolt (advanced)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Undervolt the CPU while playing (Curve Optimizer, through RyzenAdj)" IsChecked="{Binding S.UndervoltEnabled}" />
                    <TextBlock Text="Lower voltage means less heat, so the chip boosts higher in the same power limit. It can't damage hardware: too far only causes crashes. The launcher starts gently (-5), goes one step further after each clean session, and backs off a step and stays there after any crash or freeze. It's only active while a game runs, and resets on reboot. Ryzen APUs only."
                               Style="{StaticResource Wrap}" Margin="0,8,0,8" />
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding S.UndervoltEnabled}">
                        <TextBlock Text="Go as far as" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox SelectedItem="{Binding S.UndervoltTarget}" Width="72">
                            <ComboBox.ItemsSource>
                                <x:Array Type="sys:Int32">
                                    <sys:Int32>-10</sys:Int32>
                                    <sys:Int32>-15</sys:Int32>
                                    <sys:Int32>-20</sys:Int32>
                                    <sys:Int32>-25</sys:Int32>
                                    <sys:Int32>-30</sys:Int32>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                        <Button Content="Reset" Margin="8,0,0,0" Command="{Binding ResetUndervoltCommand}" ToolTip="Start the ladder again from 0" />
                    </StackPanel>
                    <TextBlock Text="{Binding UndervoltText}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="In-game" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Quick FPS target switch: hold View and press D-pad up/down, or Ctrl+Alt+Up/Down" IsChecked="{Binding S.QuickSwitch}" />
                    <CheckBox Content="Quick menu: hold View + LB to show target and power in the overlay; D-pad left/right changes power by 5 W" IsChecked="{Binding S.QuickMenu}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Adaptive cap: after" IsChecked="{Binding S.AdaptiveCap}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding S.AdaptiveIdleSeconds}" Width="44" Margin="8,0" IsEnabled="{Binding S.AdaptiveCap}" />
                        <TextBlock Text="s with no input (menus, maps, cutscenes) cap at" VerticalAlignment="Center" />
                        <TextBox Text="{Binding S.AdaptiveIdleCap}" Width="44" Margin="8,0" IsEnabled="{Binding S.AdaptiveCap}" />
                        <TextBlock Text="FPS; any input restores it" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="Compare RTSS limiter modes per game (async vs front-edge sync) and keep the smoother one" IsChecked="{Binding S.AutoLimiterMode}" />
                    <TextBlock Text="The new target shows briefly in the overlay and is kept for that game. The limiter comparison needs an RTSS version that stores the mode in its profiles; otherwise it stays off."
                               Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Thermal guard" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Lower the frame cap a step (117 → 110 → 100 → 90…) when the CPU/GPU gets near its alert limit; restore it once cool" IsChecked="{Binding T.Enabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding T.Enabled}">
                        <TextBlock Text="Act within" VerticalAlignment="Center" Width="80" />
                        <TextBox Text="{Binding T.MarginC}" Width="50" />
                        <TextBlock Text="°C of the limit, after" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox Text="{Binding T.StepDownAfterSeconds}" Width="50" />
                        <TextBlock Text="s.  Never below" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox Text="{Binding T.MinimumCap}" Width="50" />
                        <TextBlock Text="FPS" VerticalAlignment="Center" Margin="8,0" />
                    </StackPanel>
                    <TextBlock Text="Uses RTSS to change the cap live without restarting the game; it's put back to your target when the session ends." Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="RTSS &amp; MSI Afterburner" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="In-game overlay line (shown through RTSS, below Afterburner's)" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="overlay" Content="Off" IsChecked="{Binding S.Overlay, Converter={StaticResource Eq}, ConverterParameter=Off}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="overlay" Content="FPS + temps" IsChecked="{Binding S.Overlay, Converter={StaticResource Eq}, ConverterParameter=FpsAndTemps}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="overlay" Content="Detailed" IsChecked="{Binding S.Overlay, Converter={StaticResource Eq}, ConverterParameter=Detailed}" />
                    </WrapPanel>
                    <TextBlock Text="Tip: Afterburner draws its own lines too. To see one counter only, either set this to Off, or untick &quot;Show in On-Screen Display&quot; for those items in Afterburner → Settings → Monitoring."
                               Style="{StaticResource Wrap}" Margin="0,2,0,8" />
                    <CheckBox Content="Use MSI Afterburner's sensor readings when it's running (no double sensor polling)" IsChecked="{Binding S.PreferAfterburnerSensors}" />
                    <TextBlock Text="Designed not to conflict: the overlay line uses its own RTSS slot (Afterburner's lines stay as they are), only per-game RTSS profiles are touched (just the frame limit), and RTSS's global settings are never changed."
                               Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Auto-tune &amp; benchmarks" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Turn on auto-tune for newly added games" IsChecked="{Binding S.AutoTuneNewGames}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Benchmark length" VerticalAlignment="Center" Width="120" />
                        <TextBox Text="{Binding S.BenchmarkSeconds}" Width="60" />
                        <TextBlock Text="seconds. Start one in-game with Ctrl+Alt+B." VerticalAlignment="Center" Margin="8,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Save backups" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Back up saves before and after each session (only when they changed)" IsChecked="{Binding B.Enabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Keep the last" VerticalAlignment="Center" Width="90" />
                        <TextBox Text="{Binding B.KeepPerGame}" Width="50" />
                        <TextBlock Text="backups per game (locally and on each destination)" VerticalAlignment="Center" Margin="8,0" />
                    </StackPanel>
                    <TextBlock Text="Extra copies" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Destinations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="Medium" /><Run Text="  " /><Run Text="{Binding Label, Mode=OneWay}" />
                                        <Run Text="  ·  " Foreground="{StaticResource Muted}" /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource ChipButton}" Content="+ Google Drive" Command="{Binding AddGoogleDriveCommand}" ToolTip="Uses the Google Drive for desktop folder (My Drive), which syncs to the cloud" />
                        <Button Style="{StaticResource ChipButton}" Content="+ USB drive" Command="{Binding AddUsbCommand}" />
                        <Button Style="{StaticResource ChipButton}" Content="+ Other folder" Command="{Binding AddBackupFolderCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Wrap}" Visibility="{Binding BackupStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Startup" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Desktop shortcut that opens Fitz Launcher without the admin (UAC) prompt" IsChecked="{Binding NoUacShortcut}" />
                    <CheckBox Content="Start with Windows (minimised, no prompt)" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Text="Both use a Windows Task Scheduler task that runs with highest privileges, the standard way to skip the prompt. Turn them off to remove the tasks."
                               Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Visibility="{Binding StartupStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="DLSS / XeSS / FSR DLL updates" Style="{StaticResource H2}" />
            <TextBlock Text="The newest copy of each upscaler DLL from your other games is offered as an update for older ones (backed up, revertible). Optionally add a folder of newer DLLs you've downloaded (e.g. from TechPowerUp)."
                       Style="{StaticResource Wrap}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Choose DLL folder…" Command="{Binding PickDllFolderCommand}" />
                <TextBlock Text="{Binding S.UpscalerDllFolder}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="Launcher" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Record FPS during play (ETW, no overlay or injection: anti-cheat safe)" IsChecked="{Binding S.TrackFps}" />
                    <CheckBox Content="Minimise the launcher while a game is running" IsChecked="{Binding S.MinimizeWhilePlaying}" />
                    <CheckBox Content="Launch games as administrator (only for old games that need it; breaks some Steam games)" IsChecked="{Binding S.LaunchGamesAsAdmin}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Artwork" Style="{StaticResource H2}" />
            <TextBlock Text="Covers come from Steam automatically. For games not on Steam, add a free SteamGridDB API key (steamgriddb.com → Preferences → API)." Style="{StaticResource Wrap}" Margin="0,0,0,8" />
            <TextBox Text="{Binding S.SteamGridDbApiKey}" Width="420" HorizontalAlignment="Left" />

            <TextBlock Text="Sync library and settings" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Keep my library, settings, FPS history and artwork in a sync folder" IsChecked="{Binding S.SyncEnabled}" />
                    <TextBlock Text="Uses the Google Drive for desktop folder, so a Windows reinstall or another PC can pick up where you left off. Synced after each session; on start-up the launcher offers newer data from another PC."
                               Style="{StaticResource Wrap}" Margin="0,8,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Change…" Command="{Binding PickSyncFolderCommand}" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding SyncFolderText}" Style="{StaticResource Figure}" FontSize="12" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Sync now" Command="{Binding SyncNowCommand}" Margin="0,0,8,0" />
                        <Button Content="Restore from sync…" Style="{StaticResource GhostButton}" Command="{Binding RestoreFromSyncCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Wrap}" Margin="0,8,0,0" Visibility="{Binding SyncStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Updates" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Install and restart" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateNowCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding UpdateReady, Converter={StaticResource Vis}}" />
                            <Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentVersion}" VerticalAlignment="Center" FontSize="14" />
                    </DockPanel>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Wrap}" Margin="0,8,0,0" Visibility="{Binding UpdateStatus, Converter={StaticResource HasValue}}" />
                    <CheckBox Content="Check for a new version when the launcher starts" IsChecked="{Binding S.AutoCheckUpdates}" Margin="0,8,0,0" />
                    <TextBlock Text="Private repository? Paste a GitHub token with read access to it (fine-grained token → Contents: Read-only). It's stored encrypted with your Windows account. Not needed if the repository is public."
                               Style="{StaticResource Wrap}" Margin="0,8,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Save token" Command="{Binding SaveTokenCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding TokenInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="Token saved" Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding HasToken, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Data" Style="{StaticResource H2}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="13" />
                <Button Content="Open" Margin="8,0,0,0" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
            <TextBlock Text="Library, sessions, settings, artwork and backups of every config file the launcher edited live here." Style="{StaticResource Wrap}" Margin="0,8,0,0" />

            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,24,0,0" Command="{Binding SaveCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
