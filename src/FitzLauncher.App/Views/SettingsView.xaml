<UserControl x:Class="FitzLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings are plain objects; every toggle/edit saves via the Save command or when you leave the page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,40" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />

            <TextBlock Text="Default FPS target for new games" Style="{StaticResource H2}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="90"  IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=90}" />
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="100" IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=100}" />
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="110" IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=110}" />
                <RadioButton Style="{StaticResource TargetToggle}" GroupName="def" Content="117" IsChecked="{Binding S.DefaultFpsTarget, Converter={StaticResource Eq}, ConverterParameter=117}" />
            </StackPanel>

            <TextBlock Text="Game Mode (turns on automatically when you press Play)" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Enable Game Mode" IsChecked="{Binding G.Enabled}" FontWeight="SemiBold" />
                    <StackPanel Margin="0,6,0,0" IsEnabled="{Binding G.Enabled}">
                        <CheckBox Content="Switch to the High performance power plan (skipped automatically on AMD X3D CPUs and on battery)" IsChecked="{Binding G.SwitchPowerPlan}" />
                        <CheckBox Content="Clear RAM before launch (standby list purge)" IsChecked="{Binding G.ClearRam}" />
                        <CheckBox Content="Memory guard: purge standby memory during play when free RAM runs low" IsChecked="{Binding G.StandbyListGuard}" />
                        <CheckBox Content="Pause Windows Update, background downloads, indexing and telemetry services" IsChecked="{Binding G.StopServices}" />
                        <CheckBox Content="Close updaters and pause sync apps (OneDrive) during play" IsChecked="{Binding G.CloseBackgroundApps}" />
                        <CheckBox Content="Run the game at High priority" IsChecked="{Binding G.RaiseGamePriority}" />
                        <CheckBox Content="Lower the priority of browsers and other background apps" IsChecked="{Binding G.LowerBackgroundPriority}" />
                        <CheckBox Content="0.5 ms timer resolution (Windows 10 only; Windows 11 handles this per game)" IsChecked="{Binding G.HighResolutionTimer}" />
                    </StackPanel>
                    <TextBlock Text="Everything is restored when the game closes, and also on the next start if the PC crashes mid-game." Style="{StaticResource Wrap}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Game Mode lists (one per line)" Style="{StaticResource H2}" />
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="Services paused while playing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ServicesText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Apps closed while playing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CloseText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Apps paused (suspended) while playing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SuspendText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Apps lowered to below-normal priority" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding LowPriorityText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </UniformGrid>
            <Button Content="Reset lists to defaults" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ResetGameModeListsCommand}" />

            <TextBlock Text="Temperature alerts" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="CPU alert at" VerticalAlignment="Center" Width="110" />
                        <TextBox Text="{Binding S.CpuTempAlertC}" Width="70" />
                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,30,0" />
                        <TextBlock Text="GPU alert at" VerticalAlignment="Center" Width="100" />
                        <TextBox Text="{Binding S.GpuTempAlertC}" Width="70" />
                        <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Only alert after" VerticalAlignment="Center" Width="110" />
                        <TextBox Text="{Binding S.TempAlertSustainSeconds}" Width="70" />
                        <TextBlock Text="seconds above the limit" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <CheckBox Content="Show an on-screen alert over the game (borderless / windowed games)" IsChecked="{Binding S.TempAlertOverlay}" />
                    <CheckBox Content="Play a warning sound (works in exclusive fullscreen too)" IsChecked="{Binding S.TempAlertSound}" />
                    <TextBlock Text="Typical safe limits: CPU 90-95 °C (many laptops and Ryzen 7000 run at 95 °C by design); GPU core 83-87 °C." Style="{StaticResource Wrap}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Thermal guard" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Lower the frame cap a step (117 → 110 → 100 → 90…) when the CPU/GPU gets near its alert limit; restore it once cool" IsChecked="{Binding T.Enabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding T.Enabled}">
                        <TextBlock Text="Act within" VerticalAlignment="Center" Width="80" />
                        <TextBox Text="{Binding T.MarginC}" Width="50" />
                        <TextBlock Text="°C of the limit, after" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Text="{Binding T.StepDownAfterSeconds}" Width="50" />
                        <TextBlock Text="s.  Never below" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Text="{Binding T.MinimumCap}" Width="50" />
                        <TextBlock Text="FPS" VerticalAlignment="Center" Margin="6,0" />
                    </StackPanel>
                    <TextBlock Text="Uses RTSS to change the cap live without restarting the game; it's put back to your target when the session ends." Style="{StaticResource Wrap}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="RTSS &amp; MSI Afterburner" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Add a Fitz line to the RTSS overlay (cap, 1% low, thermal guard, benchmark timer)" IsChecked="{Binding S.RtssOverlay}" />
                    <CheckBox Content="Use MSI Afterburner's sensor readings when it's running (no double sensor polling)" IsChecked="{Binding S.PreferAfterburnerSensors}" />
                    <TextBlock Text="Designed not to conflict: the overlay line uses its own RTSS slot (Afterburner's lines stay as they are), only per-game RTSS profiles are touched (just the frame limit), and RTSS's global settings are never changed."
                               Style="{StaticResource Wrap}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Auto-tune &amp; benchmarks" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Turn on auto-tune for newly added games" IsChecked="{Binding S.AutoTuneNewGames}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Benchmark length" VerticalAlignment="Center" Width="120" />
                        <TextBox Text="{Binding S.BenchmarkSeconds}" Width="60" />
                        <TextBlock Text="seconds. Start one in-game with Ctrl+Alt+B." VerticalAlignment="Center" Margin="6,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Save backups" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Back up saves before and after each session (only when they changed)" IsChecked="{Binding B.Enabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Keep the last" VerticalAlignment="Center" Width="90" />
                        <TextBox Text="{Binding B.KeepPerGame}" Width="50" />
                        <TextBlock Text="backups per game (locally and on each destination)" VerticalAlignment="Center" Margin="6,0" />
                    </StackPanel>
                    <TextBlock Text="Extra copies" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Destinations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Label, Mode=OneWay}" />
                                        <Run Text="  ·  " Foreground="{StaticResource Muted}" /><Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource ChipButton}" Content="+ Google Drive" Command="{Binding AddGoogleDriveCommand}" ToolTip="Uses the Google Drive for desktop folder (My Drive), which syncs to the cloud" />
                        <Button Style="{StaticResource ChipButton}" Content="+ USB drive" Command="{Binding AddUsbCommand}" />
                        <Button Style="{StaticResource ChipButton}" Content="+ Other folder" Command="{Binding AddBackupFolderCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Wrap}" Visibility="{Binding BackupStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Startup" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Desktop shortcut that opens Fitz Launcher without the admin (UAC) prompt" IsChecked="{Binding NoUacShortcut}" />
                    <CheckBox Content="Start with Windows (minimised, no prompt)" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Text="Both use a Windows Task Scheduler task that runs with highest privileges, the standard way to skip the prompt. Turn them off to remove the tasks."
                               Style="{StaticResource Wrap}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Visibility="{Binding StartupStatus, Converter={StaticResource HasValue}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="DLSS / XeSS / FSR DLL updates" Style="{StaticResource H2}" />
            <TextBlock Text="The newest copy of each upscaler DLL from your other games is offered as an update for older ones (backed up, revertible). Optionally add a folder of newer DLLs you've downloaded (e.g. from TechPowerUp)."
                       Style="{StaticResource Wrap}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Choose DLL folder…" Command="{Binding PickDllFolderCommand}" />
                <TextBlock Text="{Binding S.UpscalerDllFolder}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock Text="Launcher" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Content="Record FPS during play (ETW, no overlay or injection: anti-cheat safe)" IsChecked="{Binding S.TrackFps}" />
                    <CheckBox Content="Minimise the launcher while a game is running" IsChecked="{Binding S.MinimizeWhilePlaying}" />
                    <CheckBox Content="Launch games as administrator (only for old games that need it; breaks some Steam games)" IsChecked="{Binding S.LaunchGamesAsAdmin}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Artwork" Style="{StaticResource H2}" />
            <TextBlock Text="Covers come from Steam automatically. For games not on Steam, add a free SteamGridDB API key (steamgriddb.com → Preferences → API)." Style="{StaticResource Wrap}" Margin="0,0,0,6" />
            <TextBox Text="{Binding S.SteamGridDbApiKey}" Width="420" HorizontalAlignment="Left" />

            <TextBlock Text="Data" Style="{StaticResource H2}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="13" />
                <Button Content="Open" Margin="10,0,0,0" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
            <TextBlock Text="Library, sessions, settings, artwork and backups of every config file the launcher edited live here." Style="{StaticResource Wrap}" Margin="0,6,0,0" />

            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Command="{Binding SaveCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
