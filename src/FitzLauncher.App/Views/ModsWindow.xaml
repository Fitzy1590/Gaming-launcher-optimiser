<Window x:Class="FitzLauncher.App.Views.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1120" Height="820" MinWidth="820" MinHeight="560"
        Background="{DynamicResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/Assets/fitz.ico">
    <Window.Resources>
        <!-- One finding/issue row, coloured by severity -->
        <DataTemplate x:Key="IssueTemplate">
            <Border Style="{StaticResource Card}" x:Name="card">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Turn mod off" VerticalAlignment="Top" Margin="12,0,0,0" Command="{Binding DisableCommand}"
                            Visibility="{Binding CanDisable, Converter={StaticResource Vis}}" />
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Secondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Wrap}" Margin="16,4,0,0" />
                        <TextBlock Text="{Binding Fix}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Margin="16,4,0,0" Visibility="{Binding HasFix, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="dot" Property="Fill" Value="{StaticResource Bad}" /></DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter TargetName="dot" Property="Fill" Value="{StaticResource Warn}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero: the game's art, Console style -->
        <Grid Height="190" ClipToBounds="True">
            <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.9" />
            <Border Background="{DynamicResource ArtScrim}" />
            <Border Background="{DynamicResource ArtFade}" />
            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,8">
                <TextBlock Text="Mods" Style="{StaticResource MutedText}" FontSize="14" />
                <TextBlock Text="{Binding Game.Name}" Style="{StaticResource Display}" FontSize="36" />
                <TextBlock Text="{Binding LayoutText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Installed" Command="{Binding ShowTabCommand}" CommandParameter="Installed" IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Installed}" GroupName="modtabs" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Find mods" Command="{Binding ShowTabCommand}" CommandParameter="Find" IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Find}" GroupName="modtabs" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Check" Command="{Binding ShowTabCommand}" CommandParameter="Check" IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Check}" GroupName="modtabs" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Troubleshoot" Command="{Binding ShowTabCommand}" CommandParameter="Troubleshoot" IsChecked="{Binding Tab, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Troubleshoot}" GroupName="modtabs" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="1" Background="{StaticResource Surface2}" Padding="32,8" Visibility="{Binding Status, Converter={StaticResource HasValue}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="48" Height="3" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
            </StackPanel>
        </Border>

        <!-- ============================== Installed -->
        <DockPanel Grid.Row="2" Margin="32,16,32,24" Visibility="{Binding Tab, Converter={StaticResource PageVis}, ConverterParameter=Installed}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource PlayButton}" Padding="24,8" FontSize="14" Command="{Binding ShowTabCommand}" CommandParameter="Find">Find mods</Button>
                <Button Content="Add from file…" Margin="8,0,0,0" Command="{Binding AddFromFileCommand}" ToolTip="Install a .zip/.7z/.rar you downloaded yourself" />
                <Button Content="Check" Margin="8,0,0,0" Command="{Binding CheckCommand}" />
                <Button Content="Check for updates" Margin="8,0,0,0" Command="{Binding CheckModUpdatesCommand}" />
                <Button Content="Open game folder" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenModsFolderCommand}" />
                <Button Content="Remove all" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RemoveAllCommand}" Visibility="{Binding HasMods, Converter={StaticResource Vis}}" />
            </StackPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding BisectActive, Converter={StaticResource Vis}}" BorderBrush="{DynamicResource Accent}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="It crashed" Command="{Binding BisectCrashedCommand}" />
                        <Button Content="No crash" Margin="8,0,0,0" Command="{Binding BisectFineCommand}" />
                        <Button Content="Stop" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding StopBisectCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BisectText}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
                </DockPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="Later mods win when two change the same file. Turning a mod off takes its files out of the game and puts back what was there." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasMods, Converter={StaticResource NotVis}}">
                    <TextBlock Text="No mods yet" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                    <TextBlock Text="Search Nexus Mods, Thunderstore or mod.io, or add an archive you already downloaded." Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Installed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" x:Name="card">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,12,0" ToolTip="On / off" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource GhostButton}" Command="{Binding UpCommand}" ToolTip="Earlier (loses conflicts)"><TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="12" /></Button>
                                            <Button Style="{StaticResource GhostButton}" Command="{Binding DownCommand}" ToolTip="Later (wins conflicts)"><TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" /></Button>
                                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" Margin="0,0,8,0" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}" />
                                            <Button Style="{StaticResource GhostButton}" Content="Page" Command="{Binding OpenPageCommand}" />
                                            <Button Style="{StaticResource GhostButton}" Content="Remove" Command="{Binding RemoveCommand}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}" />
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasIssue, Converter={StaticResource Vis}}" ToolTip="See Check" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ============================== Find -->
        <DockPanel Grid.Row="2" Margin="32,16,32,24" Visibility="{Binding Tab, Converter={StaticResource PageVis}, ConverterParameter=Find}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ChipToggle}" Content="Nexus Mods" GroupName="src" Margin="0,0,4,0" IsChecked="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=Nexus}" />
                    <RadioButton Style="{StaticResource ChipToggle}" Content="Thunderstore" GroupName="src" Margin="0,0,4,0" IsChecked="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=Thunderstore}" />
                    <RadioButton Style="{StaticResource ChipToggle}" Content="mod.io" GroupName="src" Margin="0,0,12,0" IsChecked="{Binding Source, Converter={StaticResource Eq}, ConverterParameter=ModIo}" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PlayButton}" Padding="24,8" FontSize="14" Margin="8,0,0,0" Command="{Binding SearchCommand}" IsDefault="True">Search</Button>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty for the most popular mods" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Link stores" Style="{StaticResource GhostButton}" Command="{Binding LinkStoresCommand}" ToolTip="Match this game on Nexus, Thunderstore and mod.io again" />
                <TextBlock Text="{Binding StoreText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Nexus file picker -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Visibility="{Binding HasNexusFiles, Converter={StaticResource Vis}}" MaxHeight="260">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding NexusFilesTitle}" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NexusFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Install" Command="{Binding InstallCommand}" VerticalAlignment="Top" />
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxHeight="34" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" Background="{StaticResource Surface}" Padding="12" Margin="0,0,0,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource StrongBorder}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="120" Height="68" CornerRadius="10" Background="{StaticResource Surface2}" Margin="0,0,16,0" ClipToBounds="True">
                                <Border.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="120" Height="68" CornerRadius="10" Background="Black" /></VisualBrush.Visual></VisualBrush></Border.OpacityMask>
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Installed" Foreground="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsInstalled, Converter={StaticResource Vis}}" />
                                <Button Content="Page" Style="{StaticResource GhostButton}" Command="{Binding OpenPageCommand}" />
                                <Button Content="{Binding InstallLabel}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding InstallCommand}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Secondary}" FontSize="13" TextWrapping="Wrap" MaxHeight="36" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ============================== Check -->
        <DockPanel Grid.Row="2" Margin="32,16,32,24" Visibility="{Binding Tab, Converter={StaticResource PageVis}, ConverterParameter=Check}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PlayButton}" Padding="24,8" FontSize="14" Command="{Binding CheckCommand}">Run check</Button>
                <TextBlock Text="{Binding CheckSummary}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" FontSize="15" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Checks mod loaders (SKSE, BepInEx, UE4SS, ASI…), script extender vs game version, game updates since install, 32/64-bit DLLs, missing Bethesda masters, missing dependencies, DLL clashes with ReShade/DXVK, and which mod wins each overlap." Style="{StaticResource Wrap}" Margin="0,0,0,12" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" />
            </ScrollViewer>
        </DockPanel>

        <!-- ============================== Troubleshoot -->
        <DockPanel Grid.Row="2" Margin="32,16,32,24" Visibility="{Binding Tab, Converter={StaticResource PageVis}, ConverterParameter=Troubleshoot}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource PlayButton}" Padding="24,8" FontSize="14" Command="{Binding AnalyseCommand}">Analyse crash</Button>
                <Button Content="Copy error report" Margin="8,0,0,0" Command="{Binding CopyReportCommand}" ToolTip="Game, PC, loaders, mod list, findings and log tails, with your Windows user name hidden" />
                <Button Content="Find the bad mod" Margin="8,0,0,0" Command="{Binding StartBisectCommand}" ToolTip="Turns half the mods off each session to find the one causing crashes" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding TroubleSummary}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" FontSize="15" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding BisectText}" Style="{StaticResource Wrap}" Margin="0,0,0,12" Visibility="{Binding BisectText, Converter={StaticResource HasValue}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource IssueTemplate}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
