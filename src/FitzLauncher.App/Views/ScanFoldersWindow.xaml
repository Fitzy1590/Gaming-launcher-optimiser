<Window x:Class="FitzLauncher.App.Views.ScanFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitzLauncher.App.ViewModels"
        Title="Scan game folders" Width="1000" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False" UseLayoutRounding="True">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Scan game folders" Style="{StaticResource H1}" />
            <TextBlock Text="Pick where your games are installed. Nothing is added until you review the list and press Add. The folders are remembered, so the launcher can tell you when new games appear."
                       Style="{StaticResource Wrap}" Margin="0,4,0,16" />
        </StackPanel>

        <!-- Folders -->
        <WrapPanel Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4,4,4" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                                <Button Content="×" Style="{StaticResource GhostButton}" Padding="8,0" Margin="4,0,0,0" ToolTip="Stop scanning this folder"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add folder…" Style="{StaticResource ChipButton}" Command="{Binding AddFolderCommand}" ToolTip="You can pick several folders at once" />
            <Button Content="Scan again" Style="{StaticResource ChipButton}" Command="{Binding ScanCommand}" Visibility="{Binding HasFolders, Converter={StaticResource Vis}}" />
        </WrapPanel>

        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Secondary}" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
        </StackPanel>

        <!-- Results -->
        <ListBox Grid.Row="3" ItemsSource="{Binding ResultsView}" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FoundGameRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanAdd}" VerticalAlignment="Center" ToolTip="Add this game" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Display name (you can edit it)" />
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" Margin="2,4,0,0" ToolTip="{Binding Folder}" />
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding NextExeCommand}"
                                IsEnabled="{Binding HasChoices}" ToolTip="{Binding Hint}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                
                                <TextBlock Text="{Binding ExeDisplay}" FontSize="13" />
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0" Visibility="{Binding HasChoices, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Content="Browse…" Style="{StaticResource ChipButton}" Margin="0" VerticalAlignment="Center" Command="{Binding BrowseExeCommand}" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Hint}">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusLevel, Converter={StaticResource ImpactBrush}}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" MaxWidth="230" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="{Binding AddButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AddSelectedCommand}" IsEnabled="{Binding CanAddAny}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Select all" Style="{StaticResource GhostButton}" Command="{Binding SelectAllCommand}" />
                <Button Content="Select none" Style="{StaticResource GhostButton}" Command="{Binding SelectNoneCommand}" />
                <CheckBox Content="Show games already in my library" IsChecked="{Binding ShowAlreadyAdded}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
