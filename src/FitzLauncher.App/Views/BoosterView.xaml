<UserControl x:Class="FitzLauncher.App.Views.BoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SPEC §17 G4. Read-only status; switches live in Settings. No animation. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,24" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Booster" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Wrap}" Margin="0,4,0,16"
                       Text="Shows what Game Mode has changed for the current game. Everything here is put back when the game closes. Change the switches in Settings." />
            <WrapPanel>
                <Border Style="{StaticResource Card}" Width="260" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Timer resolution" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TimerText}" Style="{StaticResource Figure}" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Power plan" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding PowerPlanText}" Style="{StaticResource Figure}" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Game CPU cores (mask, priority)" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding AffinityText}" Style="{StaticResource Figure}" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="260" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Diagnostic trace" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TraceText}" Style="{StaticResource Figure}" FontSize="16" Foreground="{StaticResource Text}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Wrap}"
                               Text="Saves one text file with your system details, the timer, power plan and CPU core masks, and the trace if you turned it on in Settings. Passwords, keys, tokens and cookies are hidden. Nothing is sent anywhere." />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Export Diagnostic Package" Command="{Binding ExportCommand}"
                                MinHeight="32" Margin="0,0,8,0" AutomationProperties.Name="Export diagnostic package" />
                        <Button Style="{StaticResource GhostButton}" Content="Refresh" Command="{Binding RefreshCommand}"
                                MinHeight="32" AutomationProperties.Name="Refresh booster status" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ExportNote}" Style="{StaticResource Wrap}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
