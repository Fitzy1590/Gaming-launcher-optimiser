<Window x:Class="FitzLauncher.App.Views.FomodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fitz Launcher · mod options" Width="720" Height="680" MinHeight="400"
        Background="{DynamicResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/Assets/fitz.ico">
    <DockPanel Margin="32,28,32,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" TextWrapping="Wrap" />
            <TextBlock Text="This mod has install options. The author's recommended choices are already ticked." Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Install" Style="{StaticResource PlayButton}" Padding="28,8" FontSize="14" Click="Install_Click" IsDefault="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Recommended" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Defaults_Click" ToolTip="Install with the author's recommended options" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GroupsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>
