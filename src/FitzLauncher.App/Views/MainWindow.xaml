<Window x:Class="FitzLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitzLauncher.App.ViewModels"
        xmlns:views="clr-namespace:FitzLauncher.App.Views"
        Title="Fitz Launcher" Width="1440" Height="880" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="/Assets/fitz.ico">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Library}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Hardware}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Sessions}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Settings}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Nav rail -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,0,24" Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}">
                        <TextBlock Text="F" FontWeight="Bold" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fitz Launcher" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Live session panel -->
                <Border DockPanel.Dock="Bottom" Margin="10" Padding="12" CornerRadius="10" Background="#1A34D399"
                        Visibility="{Binding IsPlaying, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,7,0" />
                            <TextBlock Text="GAME MODE ON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Good}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Activity}" Style="{StaticResource Wrap}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryCount}" Style="{StaticResource MutedText}" Margin="22,0,0,10" />

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Content="Library" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Library}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Hardware &amp; temps" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Hardware}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="FPS history" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Sessions}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Not-admin warning -->
            <Border Background="#33FBBF24" Padding="14,8" Visibility="{Binding NotElevated, Converter={StaticResource Vis}}">
                <TextBlock Text="Running without administrator rights: Game Mode, FPS tracking and temperatures are limited. Restart Fitz Launcher as administrator." Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
            </Border>

            <!-- Live game bar -->
            <Border Grid.Row="1" Background="#1A34D399" Padding="18,9" Visibility="{Binding IsPlaying, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding LiveText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Good}" />
            </Border>

            <!-- Toast -->
            <Border Grid.Row="2" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2" Padding="18,10"
                    Visibility="{Binding HasToast, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}" Command="{Binding DismissToastCommand}" />
                    <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Pages: kept alive (not recreated) so switching is instant. -->
            <Grid Grid.Row="3" x:Name="LibraryPage" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Library}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Margin="28,22,20,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="+ Add game" Style="{StaticResource PrimaryButton}" Click="AddGame_Click" ToolTip="Add a game exe or shortcut (Ctrl+N). You can also drag &amp; drop exes or folders onto the window." />
                        <Button Content="Add folder of games" Margin="8,0,0,0" Click="AddFolder_Click" ToolTip="Pick a folder that contains several games/repacks; each subfolder is added." />
                        <Button Content="🎮 Big Picture" Margin="8,0,0,0" Command="{Binding BigPictureCommand}" ToolTip="Fullscreen controller mode (F11)" />
                    </StackPanel>
                    <Grid Width="320" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7" />
                        <TextBlock Text="⌕" Foreground="{StaticResource Muted}" FontSize="15" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="Search  (Ctrl+F)" Foreground="{StaticResource Muted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource EmptyVis}}" />
                    </Grid>
                </DockPanel>

                <!-- Filters, sort, tags, totals -->
                <StackPanel Grid.Row="1" Margin="28,0,20,8">
                    <TextBlock Text="{Binding TotalsText}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="All" IsChecked="True" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Playing" Command="{Binding SetStatusFilterCommand}" CommandParameter="Playing" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Backlog" Command="{Binding SetStatusFilterCommand}" CommandParameter="Backlog" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Beaten" Command="{Binding SetStatusFilterCommand}" CommandParameter="Beaten" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="100%" Command="{Binding SetStatusFilterCommand}" CommandParameter="Completed" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Dropped" Command="{Binding SetStatusFilterCommand}" CommandParameter="Abandoned" />
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,2,12,8" />
                        <TextBlock Text="Sort" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Recent" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=RecentlyPlayed}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Most played" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=MostPlayed}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="A–Z" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=Name}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Added" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=RecentlyAdded}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Progress" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=Progress}" />
                        <CheckBox Content="Show hidden" IsChecked="{Binding ShowHidden}" Margin="8,0,0,6" FontSize="12" />
                    </WrapPanel>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding AllTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding}" ContentStringFormat="#{0}"
                                            Command="{Binding DataContext.SetTagFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource ChipButton}" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}"
                                Content="{Binding TagFilter}" ContentStringFormat="#{0}  ✕" Command="{Binding SetTagFilterCommand}" CommandParameter="{Binding TagFilter}"
                                Visibility="{Binding TagFilter, Converter={StaticResource HasValue}}" ToolTip="Clear tag filter" />
                    </WrapPanel>
                </StackPanel>

                <!-- Empty state -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="Your library is empty" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a game exe, or drop exes, shortcuts or game folders anywhere on this window." Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,18" HorizontalAlignment="Center" />
                    <Button Content="+ Add your first game" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="AddGame_Click" />
                </StackPanel>

                <!-- Game grid -->
                <ListBox Grid.Row="2" x:Name="GameList" ItemsSource="{Binding GamesView}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0" Padding="20,0,8,20"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         KeyboardNavigation.DirectionalNavigation="Cycle" KeyDown="GameList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Margin" Value="8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ring" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ring" Property="BorderBrush" Value="#55FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameViewModel}">
                            <Grid Width="164" Height="246" Cursor="Hand" ToolTip="{Binding Name}" Opacity="{Binding CardOpacity}">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.PlaySelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </Grid.InputBindings>
                                <!-- Placeholder -->
                                <Border CornerRadius="10" Background="{StaticResource Surface2}">
                                    <TextBlock Text="{Binding Initials}" FontSize="44" FontWeight="Bold" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Cover -->
                                <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <!-- Name strip -->
                                <Border CornerRadius="0,0,10,10" VerticalAlignment="Bottom" Padding="10,22,10,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#E6000000" Offset="0.7" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding PlayTimeText}" FontSize="11" Foreground="#B3FFFFFF" />
                                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="3" Margin="0,5,0,0"
                                                     Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>
                                <!-- Badges -->
                                <Border Background="#CC000000" CornerRadius="6" Padding="6,2" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasFpsBadge, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding FpsBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Good}" />
                                </Border>
                                <Border Background="#CC000000" CornerRadius="6" Padding="6,2" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding IsOptimized, Converter={StaticResource Vis}}" ToolTip="Optimised">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="{StaticResource Warn}" />
                                </Border>
                                <TextBlock Text="★" FontSize="14" Foreground="{StaticResource Warn}" Margin="0,30,9,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="{Binding IsFavourite, Converter={StaticResource Vis}}" />
                                <Border Background="#CC34D399" CornerRadius="6" Padding="6,2" Margin="7,32,7,7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                                    <TextBlock Text="PLAYING" FontSize="10" FontWeight="Bold" Foreground="#06281C" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Details pane -->
                <Border Grid.Column="1" Grid.RowSpan="3" Width="480" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding Details, Converter={StaticResource HasValue}}">
                    <views:GameDetailsView DataContext="{Binding Details}" />
                </Border>
            </Grid>

            <views:HardwareView Grid.Row="3" DataContext="{Binding Hardware}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Hardware}" />
            <views:SessionsView Grid.Row="3" DataContext="{Binding Sessions}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Sessions}" />
            <views:SettingsView Grid.Row="3" DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>
</Window>
