<Window x:Class="FitzLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitzLauncher.App.ViewModels"
        xmlns:views="clr-namespace:FitzLauncher.App.Views"
        Title="Fitz Launcher" Width="1440" Height="880" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="/Assets/fitz.ico">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Library}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Hardware}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Sessions}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Settings}" />
        <KeyBinding Key="F1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.About}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Nav rail -->
        <Border Background="{StaticResource Deep}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,24" Orientation="Horizontal">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Accent}">
                        <TextBlock Text="F" FontWeight="Medium" FontSize="14" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fitz Launcher" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Live session -->
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" CornerRadius="12" Background="{StaticResource Surface2}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{Binding IsPlaying, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Game Mode on" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                        <TextBlock Text="{Binding Activity}" Style="{StaticResource Wrap}" FontSize="12" LineHeight="16" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding LibraryCount}" Style="{StaticResource MutedText}" Margin="24,0,0,12" />

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Home}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Width="16" />
                            <TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Library}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Width="16" />
                            <TextBlock Text="Library" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Storage}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Width="16" />
                            <TextBlock Text="Storage" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Hardware}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" Width="16" />
                            <TextBlock Text="Hardware &amp; temps" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Sessions}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Width="16" />
                            <TextBlock Text="FPS history" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="16" />
                            <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="Help" Style="{StaticResource MutedText}" Margin="24,24,0,8" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Width="16" />
                            <TextBlock Text="How it works" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Not-admin warning -->
            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,8" Visibility="{Binding NotElevated, Converter={StaticResource Vis}}">
                <TextBlock Text="Running without administrator rights, so Game Mode, FPS tracking and temperatures are limited. Restart Fitz Launcher as administrator" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
            </Border>

            <!-- Update available -->
            <Border Grid.Row="0" Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,8"
                    Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Later" Style="{StaticResource GhostButton}" Command="{Binding DismissUpdateCommand}" Margin="0,0,8,0" />
                        <Button Content="Install and restart" Style="{StaticResource PrimaryButton}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Live game bar -->
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,8" Visibility="{Binding IsPlaying, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LiveText}" Style="{StaticResource Figure}" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Toast -->
            <Border Grid.Row="2" Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,8"
                    Visibility="{Binding HasToast, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding DismissToastCommand}" ToolTip="Dismiss"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" /></Button>
                    <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Pages: kept alive (not recreated) so switching is instant. -->
            <Grid Grid.Row="3" x:Name="LibraryPage" Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Library}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Margin="28,24,20,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Click="AddGame_Click" ToolTip="Add a game exe or shortcut (Ctrl+N), or drag and drop exes or folders onto the window"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" /><TextBlock Text="Add game" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ScanFolders_Click" ToolTip="Pick your games folders, review everything found, and add only what you tick"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" /><TextBlock Text="Scan game folders" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding BigPictureCommand}" ToolTip="Fullscreen controller mode (F11)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="14" /><TextBlock Text="Big Picture" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>
                    <Grid Width="320" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="32,8,8,8" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="14" Foreground="{StaticResource Muted}" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search  (Ctrl+F)" Foreground="{StaticResource Muted}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Search, Converter={StaticResource EmptyVis}}" />
                    </Grid>
                </DockPanel>

                <!-- Filters, sort, tags, totals -->
                <StackPanel Grid.Row="1" Margin="28,0,20,8">
                    <TextBlock Text="{Binding TotalsText}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="All" IsChecked="True" Command="{Binding SetStatusFilterCommand}" CommandParameter="All" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Playing" Command="{Binding SetStatusFilterCommand}" CommandParameter="Playing" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Backlog" Command="{Binding SetStatusFilterCommand}" CommandParameter="Backlog" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Beaten" Command="{Binding SetStatusFilterCommand}" CommandParameter="Beaten" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="100%" Command="{Binding SetStatusFilterCommand}" CommandParameter="Completed" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="status" Content="Dropped" Command="{Binding SetStatusFilterCommand}" CommandParameter="Abandoned" />
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,2,12,8" />
                        <TextBlock Text="Sort" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Recent" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=RecentlyPlayed}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Most played" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=MostPlayed}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="A–Z" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=Name}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Added" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=RecentlyAdded}" />
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="sort" Content="Progress" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=Progress}" />
                        <CheckBox Content="Show hidden" IsChecked="{Binding ShowHidden}" Margin="8,0,0,8" FontSize="12" />
                    </WrapPanel>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding AllTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding}" ContentStringFormat="#{0}"
                                            Command="{Binding DataContext.SetTagFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource ChipButton}" BorderBrush="{StaticResource StrongBorder}"
                                Content="{Binding TagFilter}" ContentStringFormat="#{0}  ×" Command="{Binding SetTagFilterCommand}" CommandParameter="{Binding TagFilter}"
                                Visibility="{Binding TagFilter, Converter={StaticResource HasValue}}" ToolTip="Clear tag filter" />
                    </WrapPanel>
                </StackPanel>

                <!-- Empty state -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="Your library is empty" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a game exe, or drop exes, shortcuts or game folders anywhere on this window." Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,16" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Click="ScanFolders_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" /><TextBlock Text="Scan my game folders" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Margin="8,0,0,0" Click="AddGame_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="14" /><TextBlock Text="Add one game" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>
                </StackPanel>

                <!-- Game grid -->
                <ListBox Grid.Row="2" x:Name="GameList" ItemsSource="{Binding GamesView}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0" Padding="20,0,8,20"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         KeyboardNavigation.DirectionalNavigation="Cycle" KeyDown="GameList_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Margin" Value="8" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ring" CornerRadius="16" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource StrongBorder}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameViewModel}">
                            <Grid Width="168" Height="252" Cursor="Hand" ToolTip="{Binding Name}" Opacity="{Binding CardOpacity}">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.PlaySelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </Grid.InputBindings>
                                <!-- Placeholder -->
                                <Border CornerRadius="12" Background="{StaticResource Surface2}">
                                    <TextBlock Text="{Binding Initials}" FontSize="44" FontWeight="Medium" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Cover -->
                                <Border CornerRadius="12" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <!-- Name strip -->
                                <Border CornerRadius="0,0,12,12" VerticalAlignment="Bottom" Padding="12,24,12,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#E6000000" Offset="0.7" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" />
                                        <TextBlock Text="{Binding PlayTimeText}" FontSize="12" Foreground="#B3FFFFFF" />
                                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="3" Margin="0,4,0,0"
                                                     Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Border>
                                <!-- Badges -->
                                <Border Background="#CC141415" CornerRadius="6" Padding="8,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding HasFpsBadge, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding FpsBadge}" Style="{StaticResource Figure}" FontSize="12" Foreground="{StaticResource Text}" />
                                </Border>
                                <Border Background="#CC141415" CornerRadius="6" Padding="8,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding IsOptimized, Converter={StaticResource Vis}}" ToolTip="Optimised">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="{StaticResource Text}" />
                                </Border>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="14" Foreground="{StaticResource Text}" Margin="0,32,8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Visibility="{Binding IsFavourite, Converter={StaticResource Vis}}" />
                                <Border Background="{StaticResource Accent}" CornerRadius="6" Padding="8,2" Margin="8,32,8,8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                                    <TextBlock Text="Playing" FontSize="12" FontWeight="Medium" Foreground="{StaticResource OnAccent}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Details pane -->
                <Border Grid.Column="1" Grid.RowSpan="3" Width="480" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding Details, Converter={StaticResource HasValue}}">
                    <views:GameDetailsView DataContext="{Binding Details}" />
                </Border>
            </Grid>

            <views:HardwareView Grid.Row="3" DataContext="{Binding Hardware}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Hardware}" />
            <views:SessionsView Grid.Row="3" DataContext="{Binding Sessions}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Sessions}" />
            <views:HomeView Grid.Row="3" DataContext="{Binding Home}"
                            Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Home}" />
            <views:StorageView Grid.Row="3" DataContext="{Binding Storage}"
                               Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Storage}" />
            <views:AboutView Grid.Row="3"
                             Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=About}" />
            <views:SettingsView Grid.Row="3" DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Settings}" />
        </Grid>
    </Grid>
</Window>
