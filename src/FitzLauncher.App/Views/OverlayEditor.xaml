<UserControl x:Class="FitzLauncher.App.Views.OverlayEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Edits an OverlayEditorViewModel: layout, items, colour and size, with a preview -->
    <StackPanel>
        <WrapPanel Margin="0,0,0,8">
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="{Binding GroupId, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="One row across the top"
                         IsChecked="{Binding Arrangement, Converter={StaticResource Eq}, ConverterParameter=Row}" />
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="{Binding GroupId, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Stacked column"
                         IsChecked="{Binding Arrangement, Converter={StaticResource Eq}, ConverterParameter=Column}" />
        </WrapPanel>
        <WrapPanel>
            <CheckBox Content="FPS" IsChecked="{Binding Fps}" Margin="0,4,16,4" />
            <CheckBox Content="Watts" IsChecked="{Binding Watts}" Margin="0,4,16,4" ToolTip="Chip power draw (the whole APU on handhelds)" />
            <CheckBox Content="CPU temp" IsChecked="{Binding CpuTemp}" Margin="0,4,16,4" />
            <CheckBox Content="GPU temp" IsChecked="{Binding GpuTemp}" Margin="0,4,16,4" />
            <CheckBox Content="1% low" IsChecked="{Binding OnePercentLow}" Margin="0,4,16,4" />
            <CheckBox Content="GPU load" IsChecked="{Binding GpuLoad}" Margin="0,4,16,4" />
            <CheckBox Content="FPS cap" IsChecked="{Binding Cap}" Margin="0,4,16,4" />
            <CheckBox Content="Clock" IsChecked="{Binding Clock}" Margin="0,4,16,4" />
        </WrapPanel>
        <DockPanel Margin="0,6,0,0">
            <CheckBox DockPanel.Dock="Left" Content="Colour" IsChecked="{Binding Coloured}" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="White values, grey labels" />
            <TextBlock DockPanel.Dock="Left" Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding SizePercent, StringFormat={}{0}%}" Width="48" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Figure}" FontSize="12" />
            <Slider Minimum="50" Maximum="150" TickFrequency="10" SmallChange="10" LargeChange="10" Value="{Binding SizePercent}" IsEnabled="{Binding Coloured}" MaxWidth="260" HorizontalAlignment="Left" Width="260" />
        </DockPanel>
        <Border Background="#C0000000" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="13" Foreground="White" />
        </Border>
    </StackPanel>
</UserControl>
