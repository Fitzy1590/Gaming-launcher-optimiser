<Window x:Class="FitzLauncher.App.Views.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fitz Launcher · problem" Width="640" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Topmost="True">
    <StackPanel Margin="32,28,32,24">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="{StaticResource Bad}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="WhatText" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" FontSize="14" Margin="0,16,0,0" />
        <TextBlock Text="What to do" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,16,0,4" />
        <TextBlock x:Name="DoText" Style="{StaticResource Wrap}" FontSize="14" />
        <WrapPanel x:Name="FixPanel" Margin="0,16,0,0" />
        <Expander Header="Technical details" Margin="0,12,0,0" Foreground="{StaticResource Secondary}">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                     Height="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,8,0,0" />
        </Expander>
        <DockPanel Margin="0,20,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Copy report" Click="Copy_Click" />
                <Button Content="Report the problem" Margin="8,0,0,0" Click="Report_Click" ToolTip="Opens a GitHub issue with the report filled in (your user name is hidden)" />
                <Button Content="Open logs" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Logs_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RestartButton" Content="Restart launcher" Margin="8,0,0,0" Click="Restart_Click" />
                <Button x:Name="CloseButton" Content="Continue" Style="{StaticResource PlayButton}" Padding="24,8" FontSize="14" Margin="8,0,0,0" Click="Close_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
