<UserControl x:Class="FitzLauncher.App.Views.ModsOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,24,32,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Mods" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <TextBlock Text="{Binding NexusText}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" />
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Manage mods" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
