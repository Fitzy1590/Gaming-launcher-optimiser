<UserControl x:Class="FitzLauncher.App.Views.EmulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Emulation" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                       Text="Games from other consoles, run through their emulators. Optimise picks the best quality your PC can hold at the FPS target, and Fitz keeps adjusting it after each session." />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Find emulators" Style="{StaticResource GhostButton}" Command="{Binding FindEmulatorsCommand}" Margin="0,0,8,0" />
            <Button Content="Add game folder" Style="{StaticResource GhostButton}" Command="{Binding AddFolderCommand}" Margin="0,0,8,0"
                    ToolTip="Pick the folder holding games for the console selected on the left" />
            <Button Content="Rescan folders" Style="{StaticResource GhostButton}" Command="{Binding RescanCommand}" Margin="0,0,8,0" />
            <Button Content="Test emulator sources" Style="{StaticResource GhostButton}" Command="{Binding TestSourcesCommand}" Margin="0,0,16,0"
                    ToolTip="Checks what Fitz would download for each emulator, so a wrong download pattern shows up" />
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="emuTab" Content="Games" IsChecked="{Binding ShowGames, Mode=OneWay}" Click="ShowGames_Click" />
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="emuTab" Content="Emulators" IsChecked="{Binding ShowEmulators, Mode=OneWay}" Click="ShowEmulators_Click" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Wrap}" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="620" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Consoles -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Focusable="False">
                <ItemsControl ItemsSource="{Binding PlatformRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="platforms" Margin="0,0,0,4"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.PickPlatformCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                </DockPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Games -->
            <Grid Grid.Column="1" Margin="0,0,16,0" Visibility="{Binding ShowGames, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Wrap}" Visibility="{Binding HasGames, Converter={StaticResource NotVis}}" />
                <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" Visibility="{Binding HasGames, Converter={StaticResource Vis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="150" Margin="4">
                                <Grid.RowDefinitions><RowDefinition Height="200" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Background="{StaticResource Surface2}" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="{Binding Initials}" Style="{StaticResource H1}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasCover, Converter={StaticResource NotVis}}" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,6,0,0" Foreground="{StaticResource Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Emulators -->
            <ScrollViewer Grid.Column="1" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowEmulators, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Emulators}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Content="Download / update" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" IsEnabled="{Binding Idle}"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource Vis}}" Margin="0,0,6,0" />
                                            <Button Content="Roll back" Style="{StaticResource GhostButton}" Command="{Binding RollbackCommand}"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource Vis}}" Margin="0,0,6,0" />
                                            <Button Content="Open download page" Style="{StaticResource GhostButton}" Command="{Binding OpenPageCommand}"
                                                    Visibility="{Binding IsWebsite, Converter={StaticResource Vis}}" Margin="0,0,6,0" />
                                            <Button Content="Browse…" Style="{StaticResource GhostButton}" Command="{Binding BrowseCommand}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Platforms}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Wrap}" FontSize="12" Visibility="{Binding VersionText, Converter={StaticResource HasValue}}" />
                                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Wrap}" FontSize="12" Foreground="{StaticResource Text}" Visibility="{Binding UpdateText, Converter={StaticResource HasValue}}" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Wrap}" FontSize="12" Foreground="{StaticResource Warn}"
                                               Visibility="{Binding HasNote, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- IGDB keys (Emulators tab) -->
            <Border Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource Card}" Margin="0,0,16,0" Visibility="{Binding ShowEmulators, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="Game descriptions (IGDB)" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock Style="{StaticResource Wrap}" FontSize="12" Margin="0,2,0,8"
                               Text="Free: create an app at dev.twitch.tv (IGDB uses Twitch sign-in) and paste its client ID and secret. The secret is stored encrypted on this PC." />
                    <DockPanel Margin="0,0,0,6"><TextBlock Text="Client ID" Width="90" VerticalAlignment="Center" /><TextBox Text="{Binding IgdbIdInput, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                    <DockPanel Margin="0,0,0,6"><TextBlock Text="Secret" Width="90" VerticalAlignment="Center" /><TextBox Text="{Binding IgdbSecretInput, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                    <Button Content="Save keys" Style="{StaticResource GhostButton}" Command="{Binding SaveIgdbCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding IgdbStatus}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Selected game -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedGame.Name}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailInfo}" Style="{StaticResource Wrap}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,0,0,12" Visibility="{Binding MetaText, Converter={StaticResource HasValue}}" />

                        <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasSuggestion, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="A better emulator for this game" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                <TextBlock Text="{Binding SuggestionText}" Style="{StaticResource Wrap}" Margin="0,4,0,8" />
                                <WrapPanel>
                                    <Button Content="Switch" Style="{StaticResource PrimaryButton}" Command="{Binding AcceptSuggestionCommand}" Margin="0,0,8,0" />
                                    <Button Content="Not now" Style="{StaticResource GhostButton}" Command="{Binding DismissSuggestionCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Play" Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" Margin="0,0,8,0" />
                            <Button Content="Optimise" Style="{StaticResource PrimaryButton}" Command="{Binding OptimiseCommand}"
                                    ToolTip="Picks the best quality this PC can hold at the target, then keeps adjusting it after each session" />
                        </WrapPanel>

                        <TextBlock Text="FPS target" Style="{StaticResource MutedText}" />
                        <ItemsControl ItemsSource="{Binding TargetChips}" Margin="0,4,0,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="emuTarget" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding PickCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Wrap}" FontSize="12" Margin="0,0,0,12"
                                   Text="Use 60 only if the game itself runs at 60. Many games on these consoles ran at 30, and asking for more only makes Fitz lower the quality for nothing." />

                        <TextBlock Text="Emulator" Style="{StaticResource MutedText}" />
                        <ItemsControl ItemsSource="{Binding EmulatorChips}" Margin="0,4,0,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="emuChoice" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding PickCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding TitleInfo}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,0,0,12" Visibility="{Binding TitleInfo, Converter={StaticResource HasValue}}" />

                        <TextBlock Text="Quality" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TuningText}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Margin="0,4,0,12" />

                        <TextBlock Text="Mods, textures and patches" Style="{StaticResource MutedText}" />
                        <ItemsControl ItemsSource="{Binding ModRows}" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" Margin="6,0,0,0" />
                                        <Button DockPanel.Dock="Right" Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}" Command="{Binding ToggleCommand}" />
                                        <TextBlock Style="{StaticResource Wrap}" VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text}" /><Run Text="{Binding Kind, Mode=OneWay, StringFormat=' · {0}'}" /></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding ModKinds}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Button Content="{Binding Label}" Style="{StaticResource GhostButton}" Command="{Binding PickCommand}" Margin="0,0,6,4" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Find mods online" Style="{StaticResource GhostButton}" Command="{Binding FindModsCommand}" Margin="0,0,6,4"
                                    ToolTip="Opens a GameBanana search for this game in your browser. Download a mod, then use Add above to install it in the right folder" />
                            <Button Content="Get description" Style="{StaticResource GhostButton}" Command="{Binding FetchMetaCommand}" Margin="0,0,6,4" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ModsStatus}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,0,0,12" Visibility="{Binding ModsStatus, Converter={StaticResource HasValue}}" />

                        <TextBlock Text="How it has run, per emulator" Style="{StaticResource MutedText}" />
                        <ItemsControl ItemsSource="{Binding PerfLines}" Margin="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Wrap}" FontSize="12" Margin="0,0,0,4" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel>
                            <Button Content="Revert emulator settings" Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" Margin="0,0,8,0"
                                    ToolTip="Puts the emulator's settings file back as it was before Fitz first changed it (affects every game on that emulator)" />
                            <Button Content="Remove from library" Style="{StaticResource GhostButton}" Command="{Binding RemoveGameCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
