<UserControl x:Class="FitzLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FitzLauncher.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,48" MaxWidth="1280" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" />

            <!-- This week: compact figures -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Played this week" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding WeekHours}" Style="{StaticResource Figure}" FontSize="24" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Sessions this week" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding WeekSessions}" Style="{StaticResource Figure}" FontSize="24" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="200" Margin="0,0,12,0" ToolTip="Share of frames delivered at your FPS target, across this week's sessions">
                    <StackPanel>
                        <TextBlock Text="Frames on target" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding WeekOnTarget}" Style="{StaticResource Figure}" FontSize="24" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="200">
                    <StackPanel>
                        <TextBlock Text="All-time" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalHours}" Style="{StaticResource Figure}" FontSize="24" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Continue playing: the covers carry the colour -->
            <TextBlock Text="Continue playing" Style="{StaticResource H2}" Visibility="{Binding HasContinue, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding ContinuePlaying}" Visibility="{Binding HasContinue, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <Border Width="280" Margin="0,0,16,16" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="11,0,0,11" Height="144" Background="{StaticResource Surface2}" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Border CornerRadius="11,0,0,11" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                                        <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,12,12,12" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="{Binding PlayTimeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" Visibility="{Binding HasProgress, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource PlayButton}" Padding="16,8" FontSize="13" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" /><TextBlock Text="Play" Margin="8,0,0,0" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Needs attention -->
            <TextBlock Text="Needs attention" Style="{StaticResource H2}" Visibility="{Binding HasAttention, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding Attention}" Visibility="{Binding HasAttention, Converter={StaticResource Vis}}" MaxWidth="880" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{Binding Action}" Style="{StaticResource ChipButton}" Margin="12,0,0,0"
                                        Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Warn}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recently added -->
            <TextBlock Text="Recently added" Style="{StaticResource H2}" Visibility="{Binding HasRecent, Converter={StaticResource Vis}}" />
            <ItemsControl ItemsSource="{Binding RecentlyAdded}" Visibility="{Binding HasRecent, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameViewModel}">
                        <Grid Width="120" Height="180" Margin="0,0,12,12" Cursor="Hand" ToolTip="{Binding Name}">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid.InputBindings>
                            <Border CornerRadius="8" Background="{StaticResource Surface2}">
                                <TextBlock Text="{Binding Initials}" FontSize="32" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="8" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
