<UserControl x:Class="FitzLauncher.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Storage" Style="{StaticResource H1}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,4,0,16" />
        </StackPanel>

        <!-- Drives -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Width="300" Margin="0,0,12,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Letter}" Style="{StaticResource Figure}" FontSize="15" />
                            </DockPanel>
                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8" />
                            <TextBlock Text="{Binding Space}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Games by size -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Padding="0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                       Visibility="{Binding Status, Converter={StaticResource HasValue}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Figure}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Warn}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsSlow, Converter={StaticResource Vis}}" ToolTip="Slow storage: may stutter" />
                            <TextBlock Text="{Binding DriveLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                            <Button Content="Move…" Style="{StaticResource ChipButton}" Margin="0,0,8,0" ToolTip="Move to another drive (e.g. SD card → NVMe); paths and saves follow"
                                    Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            <Button Content="Verify" Style="{StaticResource ChipButton}" Margin="0,0,8,0" ToolTip="Check files against the repack's checksums or a saved baseline"
                                    Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource GhostButton}" ToolTip="Open folder"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" ToolTip="Uninstall (saves are backed up first; folder goes to the Recycle Bin)"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
