<UserControl x:Class="FitzLauncher.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="980" HorizontalAlignment="Left">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Rescan hardware" Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBool}}" />
                <StackPanel>
                    <TextBlock Text="Your PC" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding ScannedText}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="Scanning hardware…" Foreground="{StaticResource Accent}" Margin="0,10,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
            <Border Background="#1A4F8CFF" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding HasDriverChange, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear shader caches" Command="{Binding ClearShaderCachesCommand}" />
                    <TextBlock Text="{Binding DriverChangedText}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Live sensors -->
            <UniformGrid Columns="5" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CPU temp" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding CpuTemp}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="GPU temp" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding GpuTemp}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CPU load" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding CpuLoad}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="GPU load" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding GpuLoad}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Memory}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" FontSize="12.5" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="{Binding SensorSource}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding SensorHint}" Style="{StaticResource Wrap}" Foreground="{StaticResource Warn}" Visibility="{Binding SensorHint, Converter={StaticResource HasValue}}" />

            <!-- Facts -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <ItemsControl ItemsSource="{Binding Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" TextTrimming="None" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Shader caches -->
            <TextBlock Text="Shader caches" Style="{StaticResource H2}" Margin="0,22,0,4" />
            <TextBlock Text="Clear these after a GPU driver update so games rebuild clean caches. Expect a few minutes of stutter per game the first time, then smoother play. Files in use are skipped."
                       Style="{StaticResource Wrap}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ShaderCaches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3" ToolTip="{Binding Path}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding MeasureShaderCachesCommand}" />
                            <Button Content="Clear all" Margin="6,0,0,0" Command="{Binding ClearShaderCachesCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ShaderStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Recommendations for this PC" Style="{StaticResource H2}" Margin="0,22,0,4" />
            <TextBlock Text="Tailored to the hardware above. Automatic items can be applied and reverted here; the rest are quick manual steps (BIOS, driver panel)."
                       Style="{StaticResource Wrap}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource TweakRow}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
