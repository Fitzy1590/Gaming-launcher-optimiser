<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <RootNamespace>FitzLauncher.App</RootNamespace>
    <AssemblyName>FitzLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fitz.ico</ApplicationIcon>
    <!-- Startup speed: tiered PGO here, ReadyToRun at publish (see build.ps1 / CI). -->
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FitzLauncher.Core\FitzLauncher.Core.csproj" />
    <ProjectReference Include="..\FitzLauncher.Windows\FitzLauncher.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF removes System.IO from implicit usings (Shapes.Path clash); none of our code uses Shapes. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\fitz.ico" />
  </ItemGroup>
</Project>
