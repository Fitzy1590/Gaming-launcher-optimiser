<Application x:Class="FitzLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FitzLauncher.App"
             xmlns:vm="clr-namespace:FitzLauncher.App.ViewModels"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibility x:Key="Vis" />
            <local:BoolToVisibility x:Key="NotVis" Invert="True" />
            <local:NullToVisibility x:Key="HasValue" />
            <local:EqualsConverter x:Key="Eq" />
            <local:ImpactToBrush x:Key="ImpactBrush" />
            <local:EqualsToVisibility x:Key="PageVis" />
            <local:EmptyToVisibility x:Key="EmptyVis" />
            <local:InvertBool x:Key="InvertBool" />

            <!-- One optimisation / recommendation row, used on the game page and the Hardware page. -->
            <DataTemplate x:Key="TweakRow" DataType="{x:Type vm:TweakViewModel}">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="14" TextWrapping="Wrap" TextTrimming="None" MaxWidth="320" />
                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="{StaticResource Surface2}"
                                        Visibility="{Binding Recommended, Converter={StaticResource Vis}}" VerticalAlignment="Center">
                                    <TextBlock Text="Recommended" FontSize="12" Foreground="{StaticResource Text}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Wrap}" Foreground="{StaticResource Warn}" Margin="0,4,0,0"
                                       Visibility="{Binding HasReason, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Wrap}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ManualSteps}" Style="{StaticResource Wrap}" Foreground="{StaticResource Text}" Margin="0,8,0,0"
                                       Visibility="{Binding IsManual, Converter={StaticResource Vis}}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding ImpactLevel, Converter={StaticResource ImpactBrush}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding ImpactText}" FontSize="12" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding HasGain, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding Gain}" FontSize="12" Foreground="{StaticResource Good}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding HasRisk, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding RiskText}" FontSize="12" Foreground="{StaticResource Warn}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Visibility="{Binding NeedsRestart, Converter={StaticResource Vis}}">
                                    <TextBlock Text="Restart needed" FontSize="12" Foreground="{StaticResource Muted}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Visibility="{Binding Message, Converter={StaticResource HasValue}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"
                                    Visibility="{Binding IsAutomatic, Converter={StaticResource Vis}}">
                            <Button Content="Apply" Command="{Binding ApplyCommand}" Visibility="{Binding IsApplied, Converter={StaticResource NotVis}}" />
                            <StackPanel Visibility="{Binding IsApplied, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource Good}" /><TextBlock Text="Applied" FontSize="12" Foreground="{StaticResource Secondary}" Margin="4,0,0,0" /></StackPanel>
                                <Button Content="Revert" Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Compact row for the 1-click list. -->
            <DataTemplate x:Key="OneClickRow" DataType="{x:Type vm:TweakViewModel}">
                <Grid Margin="0,4" ToolTip="{Binding Description}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource Good}" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="{Binding IsApplied, Converter={StaticResource Vis}}" />
                    <Ellipse Width="8" Height="8" Stroke="{StaticResource Muted}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,6,0,0" Visibility="{Binding IsApplied, Converter={StaticResource NotVis}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" />
                    <TextBlock Grid.Column="2" Text="{Binding Gain}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
