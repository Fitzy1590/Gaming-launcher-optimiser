<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only services: hardware scan (WMI), ETW FPS capture, temperatures,
       Game Mode (services, power plan, memory, timer), registry and file tweaks. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>FitzLauncher.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- LibreHardwareMonitorLib only ships runtime-specific builds. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FitzLauncher.Core\FitzLauncher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
  </ItemGroup>
</Project>
